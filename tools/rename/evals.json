{
  "name": "NeMo Evaluator to NeMo Helix Evals",
  "exclude": [
    "tools/rename/**",
    "tests/tools/rename/**",
    ".agents/skills/release-test-scope/references/*-example-report.md",
    "docs/about/release-notes/release-*",
    "docs/evals/upgrading-from-evaluator.mdx",
    ".codex/**",
    ".npm-cache/**",
    "**/*.swp"
  ],
  "notes": [
    "Deployment owners must migrate their own evals configuration, sandbox overrides, Studio feature flags, and external identity/source filters; see docs/evals/upgrading-from-evaluator.mdx. The tool preserves that guide and historical release examples.",
    "Permissions, entity type names, and task-kind discriminators are preserved. Job sources rename from nemo-evaluator to nemo-evals, including agent-evaluate and retrieve-eval; existing jobs are not migrated and no longer appear in source-filtered lists.",
    "MR compatibility note: old cloudpickle metric bundles and compiled jobs may reference removed Python modules; this rename provides no compatibility aliases or data migration.",
    "Review the diff, regenerate lockfiles with uv, run make update-sdk, and test SDK imports, plugin discovery, CLI, API routes and unchanged authorization before publishing. Verification checks only configured rules."
  ],
  "plugin": {
    "replacements": {
      "NeMo Evaluator Plugin": "NeMo Helix Evals Plugin",
      "NeMo Evaluator": "NeMo Helix Evals",
      "Nemo Evaluator": "NeMo Helix Evals",
      "Evaluator Plugin": "Evals Plugin",
      "Evaluator plugin": "Evals plugin",
      "evaluator plugin": "evals plugin",
      "Evaluator SDK": "Evals SDK",
      "evaluator SDK": "evals SDK",
      "Evaluator service": "Evals service",
      "evaluator service": "evals service",
      "Evaluator documentation": "Evals documentation",
      "Evaluator API Reference": "Evals API Reference",
      "Evaluator Troubleshooting": "Evals Troubleshooting",
      "docs/evaluator": "docs/evals",
      "../evaluator/": "../evals/",
      "troubleshooting/evaluator.mdx": "troubleshooting/evals.mdx",
      "@nemo/sdk/generated/evaluator": "@nemo/sdk/generated/evals",
      "@nemo/sdk/generated/fetchers/evaluator": "@nemo/sdk/generated/fetchers/evals",
      "generated/fetchers/evaluator": "generated/fetchers/evals",
      "evaluator-plugin-": "evals-plugin-",
      "nemo-evaluator-plugin": "nemo-evals-plugin",
      "nemo-evaluator": "nemo-evals",
      "plugins/nemo-evaluator": "plugins/nemo-evals",
      "nemo_helix_plugin.evaluator": "nemo_helix_plugin.evals",
      "nemo_helix_plugin/evaluator": "nemo_helix_plugin/evals",
      "nemo_evaluator": "nemo_evals",
      "/apis/evaluator/": "/apis/evals/",
      "_apis_evaluator_": "_apis_evals_",
      "nemo evaluator": "nemo evals",
      "NEMO_EVALUATOR_": "NEMO_EVALS_",
      "NHX_EVALUATOR_": "NHX_EVALS_",
      "VITE_FF_EVALUATOR_": "VITE_FF_EVALS_",
      "EVALUATOR_BENCHMARKS_ENABLED": "EVALS_BENCHMARKS_ENABLED",
      "EVALUATOR_ENABLED": "EVALS_ENABLED",
      "evaluatorBenchmarksEnabled": "evalsBenchmarksEnabled",
      "evaluatorEnabled": "evalsEnabled",
      "evaluator_benchmarks_enabled": "evals_benchmarks_enabled",
      "evaluator_enabled": "evals_enabled",
      "# -- evaluator is the configuration specific to": "# -- evals is the configuration specific to"
    },
    "paths": {
      "plugins/nemo-evaluator/src/nemo_evaluator": "plugins/nemo-evals/src/nemo_evals",
      "plugins/nemo-evaluator": "plugins/nemo-evals",
      "packages/nemo_helix_plugin/src/nemo_helix_plugin/evaluator": "packages/nemo_helix_plugin/src/nemo_helix_plugin/evals",
      "skills/nemo-evaluator-plugin": "skills/nemo-evals-plugin",
      "packages/nemo_helix_ext/src/nemo_helix_ext/skills/nemo-evaluator": "packages/nemo_helix_ext/src/nemo_helix_ext/skills/nemo-evals",
      "agents/nemo-studio-assistant/skills/evaluator": "agents/nemo-studio-assistant/skills/evals",
      "agents/nemo-studio-assistant/src/nemo_studio_assistant/skills/evaluator": "agents/nemo-studio-assistant/src/nemo_studio_assistant/skills/evals",
      "docs/evaluator": "docs/evals",
      "docs/troubleshooting/evaluator.mdx": "docs/troubleshooting/evals.mdx"
    },
    "rules": [
      {
        "pattern": "^name: evaluator$",
        "replacement": "name: evals",
        "include": ["agents/nemo-studio-assistant/**/SKILL.md"]
      },
      {
        "pattern": "(?<=api.services=)evaluator\\b|(?<=api.services=\\{)evaluator\\b",
        "replacement": "evals",
        "include": ["tests/unit/test_helm_clickhouse.py"]
      },
      {
        "pattern": "^([ \\t]*)- page: Evaluator[ \\t]*\\n([ \\t]*)path: ([^\\n]*troubleshooting/evals\\.mdx)",
        "replacement": "\\1- page: Evals\\n\\2slug: evals\\n\\2path: \\3",
        "include": ["docs/fern/versions/latest.yml"]
      },
      {
        "pattern": "/documentation/reference/troubleshooting/evaluator\\b",
        "replacement": "/documentation/reference/troubleshooting/evals",
        "include": ["docs/**"],
        "exclude": ["docs/fern/docs.yml"]
      },
      {
        "pattern": "^redirects:\\n(?!  # Evals troubleshooting URL rename\\.)",
        "replacement": "redirects:\\n  # Evals troubleshooting URL rename.\\n  - source: \"/documentation/reference/troubleshooting/evaluator\"\\n    destination: \"/documentation/reference/troubleshooting/evals\"\\n  - source: \"/latest/documentation/reference/troubleshooting/evaluator\"\\n    destination: \"/latest/documentation/reference/troubleshooting/evals\"\\n",
        "include": ["docs/fern/docs.yml"]
      },
      {
        "pattern": "(?<=section: )evaluator\\b",
        "replacement": "evals",
        "include": ["docs/fern/gated-nav.yml"]
      },
      {
        "pattern": "\\bevaluator\\b",
        "replacement": "evals",
        "include": ["web/packages/studio/src/routes/DashboardLandingRoute/skillActionTemplateCatalog.tsx"]
      },
      {
        "pattern": "\\bnemo\\.(cli|services|sdk|skills):evaluator\\b",
        "replacement": "nemo.\\1:evals"
      },
      {
        "pattern": "\\bevaluator(?=/(?:index|metrics|agent-eval|tutorials|experiments|sdk-resources|manage-tasks-tasksets|evaluation-approaches))",
        "replacement": "evals",
        "include": ["docs/**"]
      },
      {
        "pattern": "\\bevaluator(?=/(?:(?:index|metrics)|\\s*,))",
        "replacement": "evals",
        "include": ["docs/fern/README.md"]
      },
      {
        "pattern": "\\bevaluator\\b",
        "replacement": "evals",
        "include": ["web/packages/sdk/src/capabilities/**"]
      },
      {
        "pattern": "\\bevaluatorFetch\\b",
        "replacement": "evalsFetch",
        "include": ["web/packages/sdk/src/capabilities/fetchers.ts"]
      },
      {
        "pattern": "\\bevaluator(\\s*:\\s*\\{)",
        "replacement": "evals\\1",
        "include": ["web/packages/sdk/orval/constants.ts"]
      },
      {
        "pattern": "([\"'])evaluator\\1",
        "replacement": "\\1evals\\1",
        "include": ["web/packages/sdk/orval/constants.ts"]
      },
      {
        "pattern": "(?<=gen:)evaluator\\b|(?<=generate\\.ts )evaluator\\b",
        "replacement": "evals",
        "include": ["web/packages/sdk/package.json", "web/packages/sdk/README.md"]
      },
      {
        "pattern": "``EvaluateJob`` keeps the derived default so its\\n#: existing records still match its list\\.",
        "replacement": "``EvaluateJob`` keeps the module-derived default.",
        "include": [
          "plugins/nemo-evaluator/src/nemo_evaluator/service.py",
          "plugins/nemo-evals/src/nemo_evals/service.py"
        ]
      },
      {
        "pattern": "(?<![\\w-])evaluator\\.(evaluate|agent-evaluate|retrieve-eval)\\b(?!\\s*\\()",
        "replacement": "evals.\\1"
      },
      {
        "pattern": "^(evaluator)(\\s*=\\s*[\"'])",
        "replacement": "evals\\2",
        "include": [
          "plugins/nemo-evaluator/pyproject.toml",
          "packages/nemo_helix/pyproject.toml",
          "plugins/nemo-evals/pyproject.toml"
        ]
      },
      {
        "pattern": "((?:plugin_name|name): ClassVar\\[str\\] = )[\"']evaluator[\"']",
        "replacement": "\\1\"evals\"",
        "include": [
          "plugins/nemo-evaluator/src/nemo_evaluator/service.py",
          "plugins/nemo-evaluator/src/nemo_evaluator/cli.py",
          "plugins/nemo-evaluator/src/nemo_evaluator/config.py",
          "plugins/nemo-evals/src/nemo_evals/service.py",
          "plugins/nemo-evals/src/nemo_evals/cli.py",
          "plugins/nemo-evals/src/nemo_evals/config.py"
        ]
      },
      {
        "pattern": "\\b(client|async_client|sdk|async_sdk|self)\\.evaluator\\b",
        "replacement": "\\1.evals"
      },
      {
        "pattern": "\\bdef evaluator\\(",
        "replacement": "def evals(",
        "include": [
          "packages/nemo_helix_plugin/src/nemo_helix_plugin/client/client.py"
        ]
      },
      {
        "pattern": "((?:as_service|service_name|_EVALUATOR_SERVICE)\\s*=\\s*)[\"']evaluator[\"']",
        "replacement": "\\1\"evals\"",
        "exclude": [
          "packages/nemo_helix_plugin/tests/test_path_rule.py"
        ]
      },
      {
        "pattern": "([\"'])evaluator\\1",
        "replacement": "\\1evals\\1",
        "include": [
          "agents/nemo-studio-assistant/src/nemo_studio_assistant/register.py",
          "agents/nemo-studio-assistant/tests/test_nemo_studio_assistant.py"
        ]
      },
      {
        "pattern": "([\"'])evaluator\\1",
        "replacement": "\\1evals\\1",
        "include": [
          "packages/nemo_helix_ext/src/nemo_helix_ext/cli/manifest.py",
          "packages/nemo_helix_ext/scripts/docs_generator.py",
          "packages/nemo_helix_ext/tests/cli/test_app.py",
          "packages/nemo_helix_ext/tests/cli/test_docs_generator.py",
          "packages/nemo_helix_plugin/tests/client/test_client_resources.py",
          "packages/nemo_helix_plugin/tests/evaluator/**"
        ]
      },
      {
        "pattern": "^(\\s*)evaluator:(?=\\s*(?:\\{|$))",
        "replacement": "\\1evals:",
        "include": [
          "packages/nhx_platform/config/**",
          "contrib/auth/authentik/config/**",
          "e2e/configs/**",
          "k8s/helm/values.yaml",
          "docs/evaluator/agent-eval/gym-sandbox-configuration.mdx",
          "docs/evals/agent-eval/gym-sandbox-configuration.mdx",
          "docs/set-up/milvus.mdx"
        ]
      },
      {
        "pattern": "(NEMO_PLUGIN_SERVICES_ALLOWLIST(?:=|:\\s*)[^\\n]*?)(?<![\\w-])evaluator\\b",
        "replacement": "\\1evals"
      },
      {
        "pattern": "(assert_called_once_with\\([\\\"\\'])evaluator([\\\"\\']\\))",
        "replacement": "\\1evals\\2",
        "include": [
          "plugins/nemo-evaluator/tests/test_agent_evaluate.py",
          "plugins/nemo-evaluator/tests/test_evaluate_job.py",
          "plugins/nemo-evals/tests/test_agent_evaluate.py",
          "plugins/nemo-evals/tests/test_evaluate_job.py"
        ]
      },
      {
        "pattern": "([\\\"\\']plugin[\\\"\\']:\\s*[\\\"\\'])evaluator([\\\"\\'])",
        "replacement": "\\1evals\\2",
        "include": [
          "plugins/nemo-evaluator/tests/test_service.py",
          "plugins/nemo-evals/tests/test_service.py"
        ]
      },
      {
        "pattern": "owner = service\\.name",
        "replacement": "# Preserve the existing permission namespace for the renamed Evals service.\n    owner = {\"evals\": \"evaluator\"}.get(service.name, service.name)",
        "include": [
          "packages/nemo_helix_plugin/src/nemo_helix_plugin/authz_discovery.py"
        ]
      },
      {
        "pattern": "(status\\[[\\\"\\']plugin[\\\"\\']\\]\\s*==\\s*[\\\"\\'])evaluator([\\\"\\'])",
        "replacement": "\\1evals\\2",
        "include": [
          "e2e/test_evaluator_plugin.py"
        ]
      },
      {
        "pattern": "(--services[^\\n]*?)\\bevaluator\\b",
        "replacement": "\\1evals"
      },
      {
        "pattern": "service:evaluator\\b",
        "replacement": "service:evals",
        "include": [
          "services/core/inference-gateway/tests/integration/test_igw_with_auth.py",
          "packages/nhx_common/tests/client_factory/test_client_factory.py",
          "packages/nemo_helix_plugin/tests/test_client_provider.py",
          "packages/nemo_helix_plugin/tests/test_nemo_client_task_auth.py"
        ]
      },
      {
        "pattern": "([\\\"\\'])evaluator\\1",
        "replacement": "\\1evals\\1",
        "include": [
          "packages/nhx_common/tests/client_factory/test_client_factory.py",
          "packages/nemo_helix_plugin/tests/test_client_provider.py",
          "packages/nemo_helix_plugin/tests/test_nemo_client_task_auth.py",
          "packages/nemo_helix_plugin/tests/test_scheduler.py"
        ]
      },
      {
        "pattern": "evaluator(?=(?:Create|Get|List|Delete|Cancel|Download|Hello|Update|Replace|Normalize|Evaluate|Stream|Infer|Read|Submit|Say)[A-Z])",
        "replacement": "evals",
        "include": [
          "web/**"
        ]
      },
      {
        "pattern": "Evaluator(?=(?:Create|Get|List|Delete|Cancel|Download|Hello|Update|Replace|Normalize|Evaluate|Stream|Infer|Read|Submit|Say)[A-Z])",
        "replacement": "Evals",
        "include": [
          "web/**"
        ]
      }
    ]
  },
  "library": {
    "replacements": {
      "NeMo Evaluator SDK": "NeMo Helix Evals SDK",
      "nemo_evaluator_sdk": "nhx_evals_sdk",
      "nemo-evaluator-sdk": "nhx-evals-sdk"
    },
    "paths": {
      "packages/nemo_evaluator_sdk/src/nemo_evaluator_sdk": "packages/nhx_evals_sdk/src/nhx_evals_sdk",
      "packages/nemo_evaluator_sdk": "packages/nhx_evals_sdk"
    },
    "rules": [
      {
        "pattern": "nhx_\\[A-Za-z0-9_\\]\\+",
        "replacement": "nhx_(?!evals_sdk(?:\\\\.|\\\\s|$))[A-Za-z0-9_]+",
        "include": [
          "packages/nemo_evaluator_sdk/tests/agent_eval/test_import_hygiene.py",
          "packages/nhx_evals_sdk/tests/agent_eval/test_import_hygiene.py"
        ]
      }
    ]
  }
}
