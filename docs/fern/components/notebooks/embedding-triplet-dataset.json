olor: var(--shiki-light)\">Path(</span><span style=\"--shiki-light: #032F62; --shiki-dark: #a5d6ff; color: var(--shiki-light)\">&quot;/tmp/specter-embedding-dataset&quot;</span><span style=\"--shiki-light: #24292E; --shiki-dark: #e6edf3; color: var(--shiki-light)\">)</span>\n<span style=\"--shiki-light: #24292E; --shiki-dark: #e6edf3; color: var(--shiki-light)\">DATASET_NAME</span> <span style=\"--shiki-light: #D73A49; --shiki-dark: #ff7b72; color: var(--shiki-light)\">=</span> <span style=\"--shiki-light: #24292E; --shiki-dark: #e6edf3; color: var(--shiki-light)\">os</span><span style=\"--shiki-light: #D73A49; --shiki-dark: #ff7b72; color: var(--shiki-light)\">.</span><span style=\"--shiki-light: #24292E; --shiki-dark: #e6edf3; color: var(--shiki-light)\">environ</span><span style=\"--shiki-light: #D73A49; --shiki-dark: #ff7b72; color: var(--shiki-light)\">.</span><span style=\"--shiki-light: #24292E; --shiki-dark: #e6edf3; color: var(--shiki-light)\">get(</span><span style=\"--shiki-light: #032F62; --shiki-dark: #a5d6ff; color: var(--shiki-light)\">&quot;SPECTER_FILESET&quot;</span><span style=\"--shiki-light: #24292E; --shiki-dark: #e6edf3; color: var(--shiki-light)\">,</span> <span style=\"--shiki-light: #032F62; --shiki-dark: #a5d6ff; color: var(--shiki-light)\">&quot;specter-embedding-dataset&quot;</span><span style=\"--shiki-light: #24292E; --shiki-dark: #e6edf3; color: var(--shiki-light)\">)</span>\n<span style=\"--shiki-light: #24292E; --shiki-dark: #e6edf3; color: var(--shiki-light)\">os</span><span style=\"--shiki-light: #D73A49; --shiki-dark: #ff7b72; color: var(--shiki-light)\">.</span><span style=\"--shiki-light: #24292E; --shiki-dark: #e6edf3; color: var(--shiki-light)\">makedirs(DATASET_PATH,</span> <span style=\"--shiki-light: #24292E; --shiki-dark: #e6edf3; color: var(--shiki-light)\">exist_ok</span><span style=\"--shiki-light: #D73A49; --shiki-dark: #ff7b72; color: var(--shiki-light)\">=</span><span style=\"--shiki-light: #005CC5; --shiki-dark: #7