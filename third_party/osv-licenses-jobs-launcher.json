              "database_specific": {
                "review_status": "REVIEWED",
                "url": "https://pkg.go.dev/vuln/GO-2026-6860"
              },
              "details": "When coalescing adjacent text nodes in addText and fosterParent, appending to an existing TextNode's Data via string concatenation (n.Data += text) reallocated and copied the accumulated string on every token. Inputs containing many short text runs separated by ignored end tags (such as \"a</x>\") caused O(n^2) allocations and byte copies.\n\nAccumulate coalesced text in per-node byte slices during parsing and materialize Data strings once at the end of parse.",
              "id": "GO-2026-6860",
              "modified": "2026-10-27T21:30:04.890809062Z",
              "published": "2026-10-27T21:16:18Z",
              "references": [
                {
                  "type": "FIX",
                  "url": "https://go.dev/cl/849365"
                },
                {
                  "type": "REPORT",
                  "url": "https://go.dev/issue/82224"
                },
                {
                  "type": "WEB",
                  "url": "https://groups.google.com/g/golang-announce/c/sqrs2vTx_Xs"
                }
              ],
              "schema_version": "1.9.2",
              "summary": "Avoid quadratic complexity when coalescing text nodes in html in golang.org/x/net"
            },
            {
              "affected": [
                {
                  "database_specific": {
                    "source": "https://vuln.go.dev/ID/GO-2026-6866.json"
                  },
                  "ecosystem_specific": {
                    "imports": [
                      {
                        "path": "golang.org/x/net/html",
                        "symbols": [
                          "Render",
                          "childTextNodesAreLiteral"
                        ]
                      }
                    ]
                  },
                  "package": {
                    "ecosystem": "Go",
