#
# Copy to `.env` next to docker-compose.yml, then fill in the key below.
#
#   cp .env.example .env
#   python3 -c 'import base64,os; print("CREDENTIALS_ENCRYPTION_KEY=" + base64.urlsafe_b64encode(os.urandom(32)).decode())' >> .env
#
# A Fernet key is 32 random bytes in urlsafe base64, so the line above needs only
# the standard library — no need for `cryptography` on the host.
#
# Required. Fernet key that encrypts BYOK credential payloads at rest. There is
# deliberately no default anywhere in the repo: a committed key would mean every
# stack that forgets to override it encrypts credentials under a key published in
# this repository's history.
CREDENTIALS_ENCRYPTION_KEY=

# Required to build the image, unset to run an image somebody already built.
# `harbor` comes from PyPI, but `sandbox-k8s` is not published there, so with no
# value here the image's harbor stage cannot resolve it and `docker compose
# build` fails. Point this at an index that mirrors both.
# HARBOR_EXTRA_INDEX_URL=https://<index>/simple

# --- Optional knobs; the compose defaults are fine for local development -----
# API_PORT=8080
# DATABASE_SSL_MODE=disable
# IMAGE_BUILD_PLATFORM=linux/amd64
# IMAGE_REGISTRY=registry:5000
# HARBOR_DATASET_UPSTREAM_ALLOWED_REGISTRIES=docker.io,ghcr.io
