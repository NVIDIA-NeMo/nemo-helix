# Target definition for the sandbox_k8s runtime. Dispatch envsubst's these into
# the Harbor config at SANDBOX_K8S_CONFIG_PATH, so the names here are fixed by
# that YAML rather than by the scaled-evals settings model.
#
# Mounted as a file (not envFrom) because the Harbor config is rendered per
# evaluation from this file's contents.

# Sandboxes land in the control-plane namespace; see sandbox-rbac.yaml.
SANDBOX_NAMESPACE=nemo-helix-scaled-evals

# The worker talks to the API server with its own ServiceAccount token, via the
# kubeconfig its init container writes. No external cluster, no operator creds.
SANDBOX_CONTEXT=incluster
VERIFY_SSL=true

# Fallback only. The control-plane build publishes a task image and dispatch
# binds that digest/tag onto the Harbor config's `image:`, so this is what runs
# only for a task revision that has no image_ref of its own.
TASK_IMAGE=python:3.13-slim-bookworm

# Task images live in a private GAR repo. This is the same dockerconfigjson the
# CronJob refreshes for digest resolution, reused here as a pod pull secret.
TASK_IMAGE_PULL_SECRET=scaled-evals-gar-registry-auth

# Baked into the image at /harness by the Dockerfile.
TASK_PATH=/harness/tasks/hello-world/task
