{
  "contract_version": "fabric.adapter/v1alpha2",
  "adapter_id": "nvidia.nemo-platform.nooa",
  "adapter_kind": "python",
  "runner": {
    "module": "nemo_agents_plugin.nooa.fabric_adapter"
  },
  "model_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "provider": {"type": "string", "minLength": 1},
      "model": {"type": "string", "minLength": 1},
      "temperature": {"type": "number"},
      "api_key_env": {"type": "string", "minLength": 1},
      "base_url": {"type": "string", "minLength": 1},
      "settings": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    "required": ["provider", "model"],
    "additionalProperties": false
  },
  "settings_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "entrypoint": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$",
        "description": "The agent's async callable, as module.path:callable."
      }
    },
    "required": ["entrypoint"],
    "additionalProperties": true
  },
  "telemetry": {
    "providers": {
      "relay": {"outputs": ["atif", "otel", "openinference"]}
    }
  },
  "requirements": {},
  "config": {
    "accepts": [
      "models"
    ]
  },
  "capabilities": {
    "service": false,
    "streaming": false,
    "updates": false,
    "cancellation": false
  }
}
