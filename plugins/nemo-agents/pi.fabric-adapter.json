{
  "contract_version": "fabric.adapter/v1alpha2",
  "adapter_id": "nvidia.fabric.pi",
  "adapter_kind": "process",
  "runner": {
    "command": "node",
    "script": "dist/cli.js"
  },
  "requirements": {
    "binaries": ["node"]
  },
  "config": {
    "accepts": [
      "models",
      "models.base_url",
      "instructions.system",
      "tools.definitions",
      "tools.enabled",
      "tools.blocked",
      "skills",
      "mcp",
      "mcp.tool_filters"
    ],
    "system_instruction_modes": ["replace"]
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "insecure_http_model_hosts": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\\.?$"
            },
            {
              "pattern": "^[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]*$",
              "format": "ipv6"
            }
          ]
        },
        "uniqueItems": true,
        "description": "Hosts trusted for credential-free HTTP model forwarding through NeMo Relay >=0.11.0; no schemes, ports, paths, wildcards, brackets, or zone identifiers."
      },
      "extensions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "relay_extension_path": {
        "type": "string",
        "minLength": 1,
        "description": "Absolute path or environment.workspace-relative path to the NeMo Relay Pi extension matching the CLI release"
      }
    },
    "additionalProperties": false
  },
  "model_schema": {
    "type": "object",
    "properties": {
      "provider": {"type": "string", "minLength": 1},
      "model": {"type": "string", "minLength": 1},
      "api_key_env": {"type": "string", "minLength": 1},
      "base_url": {"type": ["string", "null"], "format": "uri"}
    },
    "required": ["provider", "model", "api_key_env"],
    "additionalProperties": false
  },
  "extension_schemas": {
    "model": {
      "type": "object",
      "description": "Pi-specific catalog metadata for a model Pi does not already ship natively. `api` is the model's wire protocol and must be supplied for an unknown (gateway-served) model; when omitted Pi inherits a built-in model's native api.",
      "properties": {
        "api": {
          "type": "string",
          "enum": [
            "openai-completions",
            "openai-responses",
            "azure-openai-responses",
            "openai-codex-responses",
            "anthropic-messages",
            "bedrock-converse-stream",
            "google-generative-ai",
            "google-vertex",
            "mistral-conversations",
            "pi-messages"
          ],
          "description": "The wire protocol Pi uses to talk to this model."
        },
        "context_window": {"type": "integer", "minimum": 1},
        "max_tokens": {"type": "integer", "minimum": 1},
        "cost": {
          "type": "object",
          "description": "Per-million-token pricing. All four rates are required and non-negative.",
          "properties": {
            "input": {"type": "number", "minimum": 0},
            "output": {"type": "number", "minimum": 0},
            "cacheRead": {"type": "number", "minimum": 0},
            "cacheWrite": {"type": "number", "minimum": 0}
          },
          "required": ["input", "output", "cacheRead", "cacheWrite"],
          "additionalProperties": false
        },
        "reasoning": {"type": "boolean"},
        "input": {"type": "array", "items": {"type": "string", "enum": ["text", "image"]}},
        "name": {"type": "string"}
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "nemo_fabric.detailed_token_usage.v1": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cached_input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cache_write_input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "reasoning_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "input_tokens_include_cache": {
              "type": "boolean"
            },
            "output_tokens_include_reasoning": {
              "type": "boolean"
            }
          },
          "required": [
            "input_tokens",
            "output_tokens",
            "cached_input_tokens",
            "cache_write_input_tokens",
            "input_tokens_include_cache",
            "output_tokens_include_reasoning",
            "total_tokens"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "run_result": {
      "type": "object",
      "properties": {
        "pi_turn_count": {"type": "integer", "minimum": 0},
        "pi_turn_started": {"type": "boolean"}
      },
      "required": ["pi_turn_count", "pi_turn_started"],
      "additionalProperties": false
    }
  },
  "tool_definition_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "kind": {"const": "module"},
      "ref": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^#]+(?:#[A-Za-z_$][A-Za-z0-9_$]*)?$"
      },
      "settings": {"type": "object"}
    },
    "required": ["kind", "ref"],
    "additionalProperties": false
  },
  "telemetry": {
    "providers": {
      "relay": {
        "outputs": ["atif", "otel", "openinference"]
      }
    }
  },
  "capabilities": {
    "metadata": { "health_checks": ["live", "active", "ready"] },
    "streaming": false,
    "cancellation": false,
    "updates": false,
    "service": false
  }
}
