set -eu
# OpenSandbox opens the log directories for non-root users before this healthcheck.
# Harbor opens the verifier log before running test.sh.
install -d -o 0 -g 0 -m 0700 /logs/verifier /tests
cd /opt/helix-task
exec /usr/bin/env -i HOME=/var/lib/helix-task/root XDG_CONFIG_HOME=/var/lib/helix-task/root/.config \
    PATH=/app/.venv/bin:/usr/bin:/bin PYTHONUNBUFFERED=1 \
    /app/.venv/bin/python /opt/helix-task/start_helix.py
