#
# The sandbox's kaniko image, built from source of Chainguard's maintained fork
# (github.com/chainguard-dev/kaniko), which publishes no images. It has the layout of kaniko's
# `debug` image that `supervise` relies on: /kaniko/executor, and a shell at /busybox/sh. kaniko
# replaces the root filesystem as it builds, except /kaniko and volumes, so busybox is a volume.
# It has no registry credential helpers: the sandbox holds no credential.

ARG KANIKO_VERSION=v1.25.19
ARG KANIKO_COMMIT=848c40225bb948bf387bb0c9bb2fa969e2ff98e9

# The fork's own pins at that commit, from its deploy/Dockerfile.
FROM golang:1.26@sha256:2005724102f45917a63e9d092fc0e4ea56ea575048ce147caad5f5f61502c365 AS build
ARG KANIKO_VERSION
ARG KANIKO_COMMIT
ARG TARGETOS
ARG TARGETARCH
ADD --keep-git-dir=false https://github.com/chainguard-dev/kaniko.git#${KANIKO_COMMIT} /src
WORKDIR /src
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -mod=vendor -trimpath \
      -ldflags "-s -w -X github.com/chainguard-dev/kaniko/pkg/version.version=${KANIKO_VERSION}" \
      -o /out/kaniko/executor ./cmd/executor \
 && mkdir -p /out/kaniko/.docker /out/kaniko/ssl/certs \
 && cp /etc/ssl/certs/ca-certificates.crt /out/kaniko/ssl/certs/

FROM busybox:musl@sha256:32b5cdad7cce41dfd53d0ae06baebcf8357a147ee7694dc706911c373bc30c37 AS busybox

FROM scratch
COPY --from=build /out/kaniko /kaniko
COPY --from=build /src/files/nsswitch.conf /etc/nsswitch.conf
COPY --from=busybox /bin /busybox
VOLUME /busybox
RUN ["/busybox/mkdir", "-p", "/bin"]
RUN ["/busybox/ln", "-s", "/busybox/sh", "/bin/sh"]
ENV HOME=/root \
    USER=root \
    PATH=/usr/local/bin:/kaniko:/busybox \
    SSL_CERT_DIR=/kaniko/ssl/certs \
    DOCKER_CONFIG=/kaniko/.docker/
WORKDIR /workspace
ENTRYPOINT ["/kaniko/executor"]
