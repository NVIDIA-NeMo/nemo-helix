{
  "model": "default/nemotron-3-5-lightning-30b-a3b-bf16",
  "dataset": "default/math-with-judge-gym-data",
  "environment": "default/math-with-judge-env",
  "training": {
    "type": "grpo",
    "finetuning_type": "lora",
    "lora": {
      "rank": 128,
      "alpha": 512,
      "dropout": 0.0,
      "exclude_modules": [
        "*out_proj*"
      ],
      "use_triton": false
    },
    "max_seq_length": 9216,
    "max_new_tokens": 8192,
    "temperature": 1.0,
    "activation_checkpointing": true,
    "learning_rate": 2e-06,
    "min_learning_rate": 1.8e-06,
    "adam_eps": 1e-08,
    "warmup_steps": 10,
    "weight_decay": 0.1,
    "epochs": 2,
    "max_steps": 60,
    "batch_size": 256,
    "micro_batch_size": 1,
    "num_prompts_per_step": 32,
    "num_generations_per_prompt": 8,
    "use_dynamic_sampling": true,
    "batch_multiplier": 2.0,
    "dynamic_sampling_max_gen_batches": 10,
    "overlong_filtering": true,
    "reward_shaping": {
      "overlong_buffer_length": 512,
      "overlong_buffer_penalty": 1.0,
      "max_response_length": 8192
    },
    "reward_scaling": {
      "source_min": 0.0,
      "source_max": 1.0,
      "target_min": -1.0,
      "target_max": 1.0
    },
    "ref_policy_kl_penalty": 0.0,
    "ratio_clip_min": 0.2,
    "ratio_clip_max": 0.28,
    "ratio_clip_c": 10.0,
    "use_leave_one_out_baseline": false,
    "normalize_rewards": true,
    "max_rollout_turns": 1,
    "truncated_importance_sampling_type": "tis",
    "truncated_importance_sampling_ratio": 2.0,
    "use_importance_sampling_correction": true,
    "vllm_tensor_parallel_size": 4,
    "vllm_gpu_memory_utilization": 0.6,
    "val_at_start": true,
    "val_at_end": true,
    "val_check_interval": 15,
    "keep_top_k": 1,
    "seed": 42,
    "parallelism": {
      "num_nodes": 1,
      "num_gpus_per_node": 4,
      "tensor_parallel_size": 1,
      "expert_parallel_size": 4
    }
  },
  "output": {
    "name": "nemotron-30ba3b-grpo-lora"
  }
}
