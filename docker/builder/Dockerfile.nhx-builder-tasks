# The image the builder's job steps run in: `nhx-build fetch|supervise|push`, and crane, which the push
# step pushes with. The push step holds a workspace's registry credential and signing key, so the image
# carries only the builder and its dependencies, not the task runtime. The sandbox runs Dockerfile.nhx-kaniko's.

ARG NHX_PYTHON_BASE=nhx-python-base
ARG NHX_PYTHON_IMAGE=python:3.13.15-slim-trixie

FROM --platform=$BUILDPLATFORM golang:1.27.3 AS crane
ARG TARGETOS TARGETARCH
ENV CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOTOOLCHAIN=local
WORKDIR /src
ADD --checksum=sha256:a52cc7d61f8b2f043b7f0be1febecead5fceb791543c4790d699440f12d6b370 \
    https://github.com/google/go-containerregistry/archive/refs/tags/v0.22.1.tar.gz /tmp/crane.tar.gz
RUN tar -xzf /tmp/crane.tar.gz --strip-components=1 -C /src
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go build -trimpath -ldflags="-s -w -X github.com/google/go-containerregistry/cmd/crane/cmd.Version=v0.22.1" -o /ko-app/crane ./cmd/crane && \
    go version -m /ko-app/crane | grep -q 'go1.27.3'

FROM ${NHX_PYTHON_BASE} AS builder
COPY --from=nhx-workspace . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --only-group builder-steps --no-editable
ARG NHX_COLLECT_SOURCES=0
ENV NHX_COLLECT_SOURCES=${NHX_COLLECT_SOURCES}
RUN --mount=type=cache,target=/root/.cache/uv \
    uv run --no-project --python /app/.venv/bin/python \
        /usr/local/bin/collect-workspace-sdists.py \
        --python /app/.venv/bin/python \
        --output /app/.source-distributions/nhx-builder-tasks && \
    uv run --no-project --python /app/.venv/bin/python \
        /usr/local/bin/collect-python-sdists.py \
        --python /app/.venv/bin/python \
        --output /app/.source-distributions/nhx-builder-tasks \
        --lock-file /app/uv.lock \
        --label app-venv && \
    uv run --no-project --python /app/.venv/bin/python \
        /usr/local/bin/collect-cpython-source.py \
        --python /app/.venv/bin/python \
        --output /app/.source-distributions/nhx-builder-tasks

# crane's Go modules, and go-containerregistry itself: crane is built from a modified checkout, so its
# own module is pinned in docker/sources/nhx-builder-tasks.json rather than fetched from the Go proxy.
FROM ${NHX_PYTHON_BASE} AS crane-sources
ARG NHX_COLLECT_SOURCES=0
ENV NHX_COLLECT_SOURCES=${NHX_COLLECT_SOURCES}
COPY docker/sources/nhx-builder-tasks.json /tmp/nhx-builder-tasks.json
COPY --from=crane /ko-app/crane /tmp/crane
RUN python3 /usr/local/bin/collect-pinned-sources.py \
        --manifest /tmp/nhx-builder-tasks.json \
        --output /source-distributions/nhx-builder-tasks && \
    python3 /usr/local/bin/collect-go-module-sources.py \
        --binary /tmp/crane \
        --output /source-distributions/nhx-builder-tasks

# The runtime's own Debian packages, not the builder's build tools.
FROM ${NHX_PYTHON_IMAGE} AS apt-sources

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates && rm -rf /var/lib/apt/lists/* && \
    dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge "20250419+deb13u1"
ARG NHX_COLLECT_SOURCES=0
ENV NHX_COLLECT_SOURCES=${NHX_COLLECT_SOURCES}
COPY docker/scripts/collect-apt-sources.sh /usr/local/bin/
RUN bash /usr/local/bin/collect-apt-sources.sh /source-distributions/nhx-builder-tasks/apt --installed

# nhx-python-base's venv is on this image's interpreter, at the same path.
FROM ${NHX_PYTHON_IMAGE} AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates && rm -rf /var/lib/apt/lists/* && \
    dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge "20250419+deb13u1"
COPY --from=builder /usr/local/bin/uv /usr/local/bin/uv
RUN --mount=type=bind,source=docker/scripts/update-python-trust.py,target=/tmp/update-python-trust.py,readonly \
    python3 /tmp/update-python-trust.py --root /usr/local --bundles-only
COPY --from=builder /app/.venv /app/.venv
COPY --from=crane /ko-app/crane /usr/local/bin/crane
COPY --from=builder /app/.source-distributions/nhx-builder-tasks/ /usr/share/nemo-helix/source-distributions/nhx-builder-tasks/
COPY --from=apt-sources /source-distributions/nhx-builder-tasks/ /usr/share/nemo-helix/source-distributions/nhx-builder-tasks/
COPY --from=crane-sources /source-distributions/nhx-builder-tasks/ /usr/share/nemo-helix/source-distributions/nhx-builder-tasks/
ENV PATH="/app/.venv/bin:$PATH" \
    VIRTUAL_ENV=/app/.venv \
    PYTHONUNBUFFERED=1

# A missing dependency fails the build rather than a job.
FROM runtime AS smoke-test
RUN nhx-build --help 2>&1 | grep -q 'fetch|supervise|push' \
    && python -c 'import nemo_builder_plugin.run.fetch, nemo_builder_plugin.run.supervise, nemo_builder_plugin.run.push' \
    && crane version

FROM runtime
