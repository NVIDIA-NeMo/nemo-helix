#
# The sandbox's kaniko image: the osscontainertools fork's `debug` image
# (github.com/osscontainertools/kaniko), pinned by digest and republished, so a release runs its own
# copy. It has the layout `supervise` relies on: /kaniko/executor, and a shell at /busybox/sh. kaniko
# replaces the root filesystem as it builds, except /kaniko and volumes, so busybox is a volume. Its
# credential helpers stay unused: `supervise` turns them off, and the sandbox holds no credential.
#
# `supervise` pins the fork's feature flags. Check them against the fork's release notes when this
# version changes.

ARG KANIKO_VERSION=v1.28.5
ARG NHX_PYTHON_BASE=nhx-python-base

FROM ghcr.io/osscontainertools/kaniko:${KANIKO_VERSION}-debug@sha256:d6d74217dc077acfd3094992e917c357080a2d3fdd1042a49e34e29a7e57c572 AS kaniko

# Keep the pinned application's behavior, but rebuild every Go binary with the CA and SSH fixes.
FROM --platform=$BUILDPLATFORM golang:1.27.3 AS go-builder
ARG TARGETOS TARGETARCH
ENV CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOTOOLCHAIN=local
WORKDIR /src
ADD --checksum=sha256:37362cb5fb31c1b1f4de07d4c1150f158864b52aa85a9c9a93f145666fd6eef8 \
    https://github.com/osscontainertools/kaniko/archive/refs/tags/v1.28.5.tar.gz /tmp/kaniko.tar.gz
RUN tar -xzf /tmp/kaniko.tar.gz --strip-components=1 -C /src
# Upstream's vendor tree still carries x/crypto v0.55.0. Refresh it before the
# vendor-mode builds to fix GO-2026-6354 and GO-2026-6355 without changing Kaniko.
RUN GOFLAGS=-mod=mod go get golang.org/x/crypto@v0.56.0 && go mod vendor
RUN --mount=type=cache,target=/root/.cache/go-build \
    go build -mod=vendor -ldflags="-w -s" -o out/ github.com/GoogleCloudPlatform/docker-credential-gcr/v2 && \
    go build -mod=vendor -ldflags="-w -s" -o out/ github.com/awslabs/amazon-ecr-credential-helper/ecr-login/cli/docker-credential-ecr-login && \
    go build -mod=vendor -ldflags="-w -s" -o out/docker-credential-acr-env github.com/osscontainertools/docker-credential-acr && \
    make out/executor out/warmer && \
    go version -m out/executor | grep -q 'go1.27.3' && \
    for binary in out/*; do \
        go version -m "$binary" | awk \
            '$1 == "dep" && $2 == "golang.org/x/crypto" && $3 != "v0.56.0" { exit 1 }' || exit 1; \
    done

FROM kaniko AS patched-kaniko
COPY --from=go-builder /src/out/ /kaniko/

# The image has no Python, so its sources are collected here. docker/sources/nhx-kaniko.json pins the
# components its Go binaries don't record: kaniko itself; BusyBox with the patches and build script
# Docker builds it with; tini's release binaries and the Ubuntu xenial glibc they link statically
# (glibc 2.23-0ubuntu10 on amd64, and on arm64 the 2.23-0ubuntu3 that cross-toolchain-base 10ubuntu1
# built); and Debian trixie's ca-certificates, from which the CA bundle is generated.
# alpine-3.23-musl.json pins the Alpine musl package BusyBox links statically. Re-check both whenever
# the digest above moves.
FROM ${NHX_PYTHON_BASE} AS sources
ARG NHX_COLLECT_SOURCES=0
ENV NHX_COLLECT_SOURCES=${NHX_COLLECT_SOURCES}
COPY docker/sources/nhx-kaniko.json docker/sources/alpine-3.23-musl.json /tmp/
COPY --from=patched-kaniko /kaniko/executor /kaniko/warmer /kaniko/docker-credential-gcr \
    /kaniko/docker-credential-ecr-login /kaniko/docker-credential-acr-env /tmp/kaniko/
RUN python3 /usr/local/bin/collect-pinned-sources.py \
        --manifest /tmp/nhx-kaniko.json \
        --manifest /tmp/alpine-3.23-musl.json \
        --output /source-distributions/nhx-kaniko && \
    bash /usr/local/bin/collect-apt-sources.sh /source-distributions/nhx-kaniko/apt ca-certificates && \
    python3 /usr/local/bin/collect-go-module-sources.py \
        --binary /tmp/kaniko/executor \
        --binary /tmp/kaniko/warmer \
        --binary /tmp/kaniko/docker-credential-gcr \
        --binary /tmp/kaniko/docker-credential-ecr-login \
        --binary /tmp/kaniko/docker-credential-acr-env \
        --output /source-distributions/nhx-kaniko

# Under /kaniko, unlike other images: kaniko builds in its own root filesystem and never snapshots
# /kaniko, so a build's RUN steps can't change the sources or copy them into the image they build.
FROM patched-kaniko AS runtime
COPY --from=sources /etc/ssl/certs/ca-certificates.crt /kaniko/ssl/certs/ca-certificates.crt
COPY --from=sources /source-distributions/nhx-kaniko/ /kaniko/source-distributions/nhx-kaniko/

# The binary runs on the image's platform, and `supervise`'s shell, /busybox/sh, is there.
FROM runtime AS smoke-test
ARG KANIKO_VERSION
RUN ["/bin/sh", "-c", "/kaniko/executor version | grep -qF \"$KANIKO_VERSION\" && test -x /busybox/sh"]

FROM runtime
