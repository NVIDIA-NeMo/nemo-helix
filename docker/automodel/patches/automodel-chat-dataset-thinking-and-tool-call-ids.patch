+def _merge_thinking_messages(messages: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
+    """Fold ``thinking`` messages into the ``reasoning_content`` of the assistant message after them.
+
+    The NeMo Platform's SFT chat schema keeps an assistant turn's reasoning in a message of its own,
+    ``{"role": "assistant", "thinking": "..."}``, ahead of the message that carries the reply and tool
+    calls. Chat templates read ``reasoning_content`` on the reply instead, so an unmerged thinking message
+    renders as an empty assistant turn and its reasoning never reaches the model.
+
+    A thinking message stays an assistant message of its own (empty content, its reasoning as
+    ``reasoning_content``) when no assistant message follows it, or when the one that follows already has a
+    ``reasoning_content`` of its own.
+    """
+    merged: List[Dict[str, Any]] = []
+    pending: str | None = None  # reasoning waiting for the assistant message it belongs to
+    for m in messages:
+        if not isinstance(m, dict):
+            merged.append(m)
+            continue
+        if pending is not None:
+            if m.get("role") == "assistant" and "thinking" not in m and "reasoning_content" not in m:
+                m = {**m, "reasoning_content": pending}
+            else:
+                merged.append({"role": "assistant", "content": "", "reasoning_content": pending})
+            pending = None
+        if "thinking" not in m:
+            merged.append(m)
+            continue
+        rest = {k: v for k, v in m.items() if k != "thinking"}
+        thinking = m["thinking"]
+        if rest.get("role") != "assistant":
+            raise ValueError("`thinking` is only valid on assistant messages")
+        if thinking is None:
+            thinking = ""
+        if not isinstance(thinking, str):
+            raise ValueError("assistant message `thinking` must be a string when provided")
+        if "reasoning_content" in rest:
+            merged.append(rest)
+        elif rest.get("content") or rest.get("tool_calls"):
+            merged.append({**rest, "reasoning_content": thinking})
+        else:
+            pending = thinking
+    if pending is not None:
+        merged.append({"role": "assistant", "content": "", "reasoning_content": pending})
+    return merged
+
+
