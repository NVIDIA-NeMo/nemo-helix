+def _bash_call(command, call_id=None):
+    call = {"type": "function", "function": {"name": "bash", "arguments": {"command": command}}}
+    if call_id is not None:
+        call["id"] = call_id
+    return call
+
+
+def test_normalize_messages_folds_thinking_messages_into_reasoning_content():
+    msgs = [
+        {"role": "system", "content": "sys"},
+        {"role": "user", "content": "task"},
+        {"role": "assistant", "thinking": "list the files first"},
+        {"role": "assistant", "content": "Looking.", "tool_calls": [_bash_call("ls")]},
+        {"role": "tool", "content": "a.py"},
+        {"role": "assistant", "thinking": "done"},
+        {"role": "assistant", "content": "All set."},
+    ]
+    norm = tcd._normalize_messages(msgs)
+
+    assert [m["role"] for m in norm] == ["system", "user", "assistant", "tool", "assistant"]
+    assert norm[2]["reasoning_content"] == "list the files first"
+    assert norm[2]["content"] == "Looking."
+    assert norm[4]["reasoning_content"] == "done"
+    assert all("thinking" not in m for m in norm)
+    # The caller's messages are not changed.
+    assert msgs[2] == {"role": "assistant", "thinking": "list the files first"}
+
+
+def test_normalize_messages_keeps_a_thinking_message_that_has_no_reply_to_join():
+    trailing = tcd._normalize_messages([{"role": "user", "content": "q"}, {"role": "assistant", "thinking": "hmm"}])
+    assert trailing[1] == {"role": "assistant", "content": "", "reasoning_content": "hmm"}
+
+    # A thinking message followed by something other than an assistant message stays its own turn.
+    separate = tcd._normalize_messages(
+        [{"role": "assistant", "thinking": "a"}, {"role": "user", "content": "u"}],
+    )
+    assert separate[0] == {"role": "assistant", "content": "", "reasoning_content": "a"}
+    assert separate[1]["role"] == "user"
+
+    wins = tcd._normalize_messages(
+        [
+            {"role": "assistant", "thinking": "from the thinking message"},
+            {"role": "assistant", "content": "x", "reasoning_content": "already on the reply"},
+        ]
+    )
+    assert len(wins) == 2
+    assert wins[1]["reasoning_content"] == "already on the reply"
+
+    # Thinking on a message that also has a reply is accepted too.
+    inline = tcd._normalize_messages([{"role": "assistant", "content": "x", "thinking": "inline"}])
+    assert inline[0]["reasoning_content"] == "inline"
+    assert "thinking" not in inline[0]
+
+
+@pytest.mark.parametrize(
+    ("message", "error_pattern"),
+    [
+        ([{"role": "user", "content": "x", "thinking": "no"}], "only valid on assistant"),
+        ([{"role": "assistant", "thinking": 3}], "thinking"),
+    ],
+)
+def test_normalize_messages_rejects_malformed_thinking(message, error_pattern):
+    with pytest.raises(ValueError, match=error_pattern):
+        tcd._normalize_messages(message)
+
+
+def test_normalize_messages_pairs_tool_results_with_the_calls_before_them():
+    msgs = [
+        {"role": "user", "content": "go"},
+        {"role": "assistant", "content": "", "tool_calls": [_bash_call("ls"), _bash_call("pwd")]},
+        {"role": "tool", "content": "a.py"},
+        {"role": "tool", "content": "/repo"},
+        {"role": "assistant", "content": "", "tool_calls": [_bash_call("cat a.py")]},
+        {"role": "tool", "content": "print(1)"},
+    ]
+    norm = tcd._normalize_messages(msgs)
+
+    # Calls without ids are named call_<index> within their message, so each turn starts again at call_0.
+    assert [c["id"] for c in norm[1]["tool_calls"]] == ["call_0", "call_1"]
+    assert [norm[2]["tool_call_id"], norm[3]["tool_call_id"]] == ["call_0", "call_1"]
+    assert norm[5]["tool_call_id"] == "call_0"
+    assert "tool_call_id" not in msgs[2]
+
+
+def test_normalize_messages_keeps_given_tool_call_ids_and_pairs_the_rest_in_order():
+    msgs = [
+        {"role": "assistant", "content": "", "tool_calls": [_bash_call("a", "x1"), _bash_call("b", "x2")]},
+        {"role": "tool", "tool_call_id": "x2", "content": "second"},
+        {"role": "tool", "content": "first"},
+    ]
+    norm = tcd._normalize_messages(msgs)
+    assert norm[1]["tool_call_id"] == "x2"
+    assert norm[2]["tool_call_id"] == "x1"
+
+
+def test_normalize_messages_rejects_a_tool_result_with_no_call_to_pair_with():
+    with pytest.raises(ValueError, match="tool_call_id"):
+        tcd._normalize_messages(
+            [
+                {"role": "assistant", "content": "", "tool_calls": [_bash_call("ls")]},
+                {"role": "tool", "content": "one"},
+                {"role": "tool", "content": "two, but only one call was made"},
+            ]
+        )
+
