+def _batch_tools(examples):
+    """Return the tool definitions the examples of a batch share, or ``None`` when they carry none.
+
+    ``processor.apply_chat_template`` takes one ``tools`` list for the whole batch, so examples whose tool
+    definitions differ cannot be rendered together. Rendering them with the wrong tools would train on a
+    prompt the agent never saw, so this raises instead; use a micro batch size of 1 for such data.
+    """
+    tool_sets = [example.get("tools") or None for example in examples]
+    first = tool_sets[0] if tool_sets else None
+    if any(tools != first for tools in tool_sets[1:]):
+        raise ValueError(
+            "Examples in one batch carry different `tools`; chat templates render one tool list per batch. "
+            "Use a micro batch size of 1 for data whose tool definitions differ between examples."
+        )
+    return first
+
