+def _merge_conversation_thinking(conversation):
+    """Fold ``thinking`` messages of a conversation into ``reasoning_content``.
+
+    The NeMo Platform keeps an assistant turn's reasoning in a message of its own,
+    ``{"role": "assistant", "thinking": "..."}``. Chat templates read ``reasoning_content`` on the
+    reply instead, so the unmerged message renders as an empty assistant turn that is also trained on,
+    and its reasoning never reaches the model. Conversations without a ``thinking`` message are returned
+    as they are. The caller's conversation is never changed.
+    """
+    if not any(isinstance(turn, dict) and "thinking" in turn for turn in conversation):
+        return conversation
+    return _merge_thinking_messages(list(conversation))
+
