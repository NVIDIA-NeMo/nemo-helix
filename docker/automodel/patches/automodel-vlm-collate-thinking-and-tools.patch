+@pytest.fixture()
+def agent_collate(collate_mod, fake_qwen_utils, monkeypatch):
+    """default_collate_fn with label building stubbed: these tests check what reaches the template."""
+    monkeypatch.setattr(collate_mod, "HAVE_QWEN_VL_UTILS", True, raising=True)
+    monkeypatch.setattr(
+        collate_mod, "build_labels_from_template", lambda input_ids, conversations, processor: torch.zeros_like(input_ids)
+    )
+    return collate_mod
+
+
+class _RecordingProcessor:
+    """Records what ``default_collate_fn`` hands to ``apply_chat_template``."""
+
+    tokenizer = DummyTokenizer()
+
+    def __init__(self):
+        self.conversations = None
+        self.kwargs = None
+
+    def apply_chat_template(self, conv_list, **kwargs):
+        self.conversations = conv_list
+        self.kwargs = kwargs
+        batch_size = len(conv_list)
+        return {"input_ids": torch.arange(1, 5).unsqueeze(0).repeat(batch_size, 1)}
+
+
+_TOOLS = [{"type": "function", "function": {"name": "bash", "parameters": {"type": "object"}}}]
+_AGENT_CONVERSATION = [
+    {"role": "user", "content": [{"type": "text", "text": "fix it"}]},
+    {"role": "assistant", "thinking": "look at the files first"},
+    {
+        "role": "assistant",
+        "content": [{"type": "text", "text": "Looking."}],
+        "tool_calls": [{"type": "function", "function": {"name": "bash", "arguments": {"command": "ls"}}}],
+    },
+    {"role": "tool", "content": [{"type": "text", "text": "a.py"}]},
+    {"role": "assistant", "thinking": "done"},
+    {"role": "assistant", "content": [{"type": "text", "text": "All set."}]},
+]
+
+
+def test_default_collate_fn_merges_thinking_and_passes_tools(agent_collate):
+    """Thinking messages become reasoning_content on the reply; the example's tools reach the template."""
+    processor = _RecordingProcessor()
+    example = {"conversation": _AGENT_CONVERSATION, "tools": _TOOLS}
+
+    agent_collate.default_collate_fn([example], processor)
+
+    assert processor.kwargs["tools"] == _TOOLS
+    (conversation,) = processor.conversations
+    assert [turn["role"] for turn in conversation] == ["user", "assistant", "tool", "assistant"]
+    assert conversation[1]["reasoning_content"] == "look at the files first"
+    assert conversation[3]["reasoning_content"] == "done"
+    assert all("thinking" not in turn for turn in conversation)
+    # The dataset's own conversation is left alone, so the next epoch merges it again.
+    assert _AGENT_CONVERSATION[1] == {"role": "assistant", "thinking": "look at the files first"}
+
+
+def test_default_collate_fn_without_tools_or_thinking_is_unchanged(agent_collate):
+    """Rows with neither key reach the template as before, with no tools argument."""
+    processor = _RecordingProcessor()
+
+    agent_collate.default_collate_fn([{"conversation": CONVERSATION}], processor)
+
+    assert "tools" not in processor.kwargs
+    assert processor.conversations == [CONVERSATION]
+
+
+def test_default_collate_fn_rejects_a_batch_with_different_tools(agent_collate):
+    other_tools = [{"type": "function", "function": {"name": "other", "parameters": {"type": "object"}}}]
+    examples = [
+        {"conversation": CONVERSATION, "tools": _TOOLS},
+        {"conversation": CONVERSATION, "tools": other_tools},
+    ]
+
+    with pytest.raises(ValueError, match="different `tools`"):
+        agent_collate.default_collate_fn(examples, _RecordingProcessor())
+
+
+def test_default_collate_fn_batch_sharing_tools_passes_them_once(agent_collate):
+    processor = _RecordingProcessor()
+    examples = [{"conversation": CONVERSATION, "tools": _TOOLS}, {"conversation": CONVERSATION, "tools": list(_TOOLS)}]
+
+    agent_collate.default_collate_fn(examples, processor)
+
+    assert processor.kwargs["tools"] == _TOOLS
+    assert len(processor.conversations) == 2
+
