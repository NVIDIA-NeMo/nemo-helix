# =============================================================================
# magi-attention wheel — Python 3.12 (for Python 3.12 consumers) - Using CUDA 13.3
# =============================================================================
FROM mamba-wheel-base-py312-cu13.3 AS magi-attention-wheel-builder-py312-cu13.3

ARG MAGI_ATTENTION_COMMIT=d7ea8afd44c790b65fab68a04a6a0fdd5adbf182
ARG NVSHMEM_VERSION=3.6.5

# Automodel's docker/Dockerfile installs the RDMA headers and NVSHMEM before it builds
# MagiAttention. Without NVSHMEM, magi_attn_comm still compiles its internode kernels and
# fails. MagiAttention finds NVSHMEM through the nvidia.nvshmem package and records its lib
# dir as the extension's RPATH, so nhx-automodel-base installs the same NVSHMEM_VERSION with
# the system pip, at the same path.
RUN apt-get update && \
    apt-get install -y --no-install-recommends --allow-change-held-packages rdma-core libibverbs-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    pip install --no-cache-dir "nvidia-nvshmem-cu13==${NVSHMEM_VERSION}"

# Build settings mirror Automodel's docker/Dockerfile: Hopper + Blackwell kernels only,
# FFA kernels JIT-compiled at runtime instead of prebuilt. versioningit stamps the wheel
# version from git tags (Automodel lists it as an extra build dependency). uv checks out a
# git dependency's submodules (CUTLASS, the flash-attention fork), so this clone does too.
RUN mkdir -p /wheels && \
    pip install --no-cache-dir versioningit && \
    git clone https://github.com/SandAI-org/MagiAttention.git /src/magi-attention && \
    cd /src/magi-attention && \
    git checkout ${MAGI_ATTENTION_COMMIT} && \
    git submodule update --init --recursive && \
    MAGI_ATTENTION_BUILD_COMPUTE_CAPABILITY="90,100" \
    MAGI_ATTENTION_PREBUILD_FFA=0 \
    uv build --wheel --no-build-isolation --out-dir=/wheels . && \
    rm -rf /src/magi-attention

# The final magi-attention-wheel image contains:
#   - cu13.3/magi_attention-*-cp312-*.whl  (for Automodel on CUDA 13.3)
FROM scratch AS magi-attention-wheel
COPY --from=magi-attention-wheel-builder-py312-cu13.3 /wheels /wheels/cu13.3

# =============================================================================
# FFmpeg / VLM wheels (manylinux_2_28) — av + opencv-python-headless + decord2
# =============================================================================
FROM quay.io/pypa/manylinux_2_28_x86_64:latest AS ffmpeg-vendor-base-py312-amd64
FROM quay.io/pypa/manylinux_2_28_aarch64:latest AS ffmpeg-vendor-base-py312-arm64

ARG TARGETARCH
FROM ffmpeg-vendor-base-py312-${TARGETARCH} AS ffmpeg-vendor-base-py312

ARG FFMPEG_VERSION=8.1.2

ENV FFMPEG_VERSION=${FFMPEG_VERSION} \
    FFMPEG_PREFIX=/ffmpeg_build \
    PKG_CONFIG_PATH=/ffmpeg_build/lib/pkgconfig:/usr/local/lib/pkgconfig \
    LD_LIBRARY_PATH=/ffmpeg_build/lib:${LD_LIBRARY_PATH:-}

RUN yum install -y \
    curl \
    git \
    nasm \
    yasm \
    openssl-devel \
    pkgconfig \
    && yum clean all

COPY docker/base/build-ffmpeg-vendor.sh /usr/local/bin/build-ffmpeg-vendor.sh
RUN chmod +x /usr/local/bin/build-ffmpeg-vendor.sh && \
    build-ffmpeg-vendor.sh

# =============================================================================
# av wheel — PyAV against shared FFmpeg 8.1.2
# =============================================================================
FROM ffmpeg-vendor-base-py312 AS av-wheel-builder-py312

ARG PYAV_VERSION=v17.1.0

ENV PKG_CONFIG_PATH=/ffmpeg_build/lib/pkgconfig \
    LD_LIBRARY_PATH=/ffmpeg_build/lib:${LD_LIBRARY_PATH:-}

RUN mkdir -p /wheels /tmp/wheelhouse && \
    /opt/python/cp312-cp312/bin/pip install -U "pip<26" "cython>=3.1,<4" "numpy>=2.0" auditwheel && \
    git clone --depth 1 --branch ${PYAV_VERSION} https://github.com/PyAV-Org/PyAV.git /src/PyAV && \
    cd /src/PyAV && \
    /opt/python/cp312-cp312/bin/pip wheel . --no-deps -w /tmp/wheelhouse && \
    auditwheel repair /tmp/wheelhouse/av-*.whl -w /wheels && \
    rm -rf /src/PyAV /tmp/wheelhouse

# =============================================================================
# opencv-python-headless wheel — opencv-python 4.13 against shared FFmpeg 8.1.2
# Python 3.12
# =============================================================================
FROM ffmpeg-vendor-base-py312 AS opencv-headless-wheel-builder-py312

ARG OPENCV_PYTHON_GIT_TAG=92

ENV CI_BUILD=1 \
    ENABLE_HEADLESS=1 \
    PKG_CONFIG_PATH=/ffmpeg_build/lib/pkgconfig:/usr/local/lib/pkgconfig \
    LD_LIBRARY_PATH=/ffmpeg_build/lib:${LD_LIBRARY_PATH:-} \
    LDFLAGS=-L/ffmpeg_build/lib

RUN yum install -y \
    zlib-devel \
    libjpeg-turbo-devel \
    && yum clean all

RUN mkdir -p /wheels /tmp/wheelhouse && \
    /opt/python/cp312-cp312/bin/pip install -U "pip<26" "numpy>=2.0" auditwheel && \
    git clone --depth 1 --branch ${OPENCV_PYTHON_GIT_TAG} https://github.com/opencv/opencv-python.git /src/opencv-python && \
    cd /src/opencv-python && \
    git submodule update --init --recursive opencv && \
    OPENCV_PYTHON_SKIP_GIT_COMMANDS=1 \
    /opt/python/cp312-cp312/bin/pip wheel . --no-deps -w /tmp/wheelhouse && \
    auditwheel repair /tmp/wheelhouse/opencv_python_headless-*.whl -w /wheels && \
    rm -rf /src/opencv-python /tmp/wheelhouse

