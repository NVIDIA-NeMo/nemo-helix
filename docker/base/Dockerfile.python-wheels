# causal-conv1d wheel - Python 3.11
# =============================================================================
FROM mamba-wheel-base AS causal-conv1d-wheel-builder

ARG CAUSAL_CONV1D_VERSION=v1.5.3

RUN mkdir -p /wheels && \
    git clone --depth 1 --branch ${CAUSAL_CONV1D_VERSION} \
    https://github.com/Dao-AILab/causal-conv1d.git /src/causal-conv1d && \
    cd /src/causal-conv1d && \
    CAUSAL_CONV1D_FORCE_BUILD=TRUE uv build --wheel --no-build-isolation --out-dir=/wheels . && \
    rm -rf /src/causal-conv1d

