# NHX Agent Hardener Tasks - the nhx-tasks image plus what `nemo agent-hardener setup` leaves on a host:
# agent-hardener's venv, the garak venv it spawns, and the openshell CLI that drives the OpenShell gateway.
# Both venvs stay out of /app/.venv because garak's pins conflict with the platform's.

ARG NHX_PYTHON_BASE=nhx-python-base
ARG NHX_CPU_TASKS_BASE=nhx-tasks

FROM ${NHX_PYTHON_BASE} AS builder
ARG TARGETARCH
ARG AGENT_HARDENER_SPEC=nvidia-agent-hardener==0.0.15
ARG OPENSHELL_VERSION=0.1.2
ARG OPENSHELL_SHA256_AMD64=7eb6917285331a09e3300266a0558616481a5e9927cae2612ea07c4045b6dd6f
ARG OPENSHELL_SHA256_ARM64=9880c5776688231d5242deb046cdee361734f94901b9123949a0baf29fdadd9e
ENV UV_PYTHON_INSTALL_DIR=/opt/agent-hardener/python \
    AGENT_HARDENER_GARAK_PYTHON=/opt/agent-hardener/garak-venv/bin/python
# The same install `nemo agent-hardener setup` runs (cli/provisioning.py). The garak venv comes from
# agent-hardener's own provisioner so its garak pin stays the single source of truth.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv --python 3.12 /opt/agent-hardener/venv && \
    uv pip install --prerelease allow --python /opt/agent-hardener/venv/bin/python "${AGENT_HARDENER_SPEC}" && \
    /opt/agent-hardener/venv/bin/python -c \
        "from agent_hardener.garak_venv import provision_garak_venv; provision_garak_venv()"
RUN set -eux; \
    case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
        amd64) target="x86_64-unknown-linux-musl"; sha256="${OPENSHELL_SHA256_AMD64}" ;; \
        arm64|aarch64) target="aarch64-unknown-linux-musl"; sha256="${OPENSHELL_SHA256_ARM64}" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH:-unknown}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/openshell.tar.gz \
        "https://github.com/NVIDIA/OpenShell/releases/download/v${OPENSHELL_VERSION}/openshell-${target}.tar.gz"; \
    echo "${sha256}  /tmp/openshell.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/openshell.tar.gz -C /usr/local/bin openshell; \
    rm /tmp/openshell.tar.gz; \
    /usr/local/bin/openshell --version
ARG NHX_COLLECT_SOURCES=0
ENV NHX_COLLECT_SOURCES=${NHX_COLLECT_SOURCES}
RUN --mount=type=cache,target=/root/.cache/uv \
    set -eu; \
    mkdir -p /opt/agent-hardener/.source-distributions; \
    for venv in venv garak-venv; do \
        uv run --no-project --python /app/.venv/bin/python \
            /usr/local/bin/collect-python-sdists.py \
            --python "/opt/agent-hardener/${venv}/bin/python" \
            --output /opt/agent-hardener/.source-distributions \
            --label "agent-hardener-${venv}"; \
    done

FROM ${NHX_CPU_TASKS_BASE} AS runtime
COPY --chown=1000:1000 --from=builder /opt/agent-hardener/python /opt/agent-hardener/python
COPY --chown=1000:1000 --from=builder /opt/agent-hardener/venv /opt/agent-hardener/venv
COPY --chown=1000:1000 --from=builder /opt/agent-hardener/garak-venv /opt/agent-hardener/garak-venv
COPY --chown=1000:1000 --from=builder /opt/agent-hardener/.source-distributions/ /usr/share/nemo-helix/source-distributions/nhx-agent-hardener-tasks/
COPY --from=builder /usr/local/bin/openshell /usr/local/bin/openshell
ENV NEMO_AGENT_HARDENER_VENV_PATH=/opt/agent-hardener/venv \
    NEMO_AGENT_HARDENER_GARAK_VENV_PATH=/opt/agent-hardener/garak-venv
# agent-hardener keeps per-run state under <cwd>/.agent-hardener; /app is the root-owned venv.
WORKDIR /home/nvs

FROM runtime AS smoke-test
# The war-game fails minutes in, after the run record exists, when any of these is missing, so check
# them at build time: the task entrypoints import, both venvs run, and the openshell CLI launches.
RUN set -eux; \
    python -c "import nemo_agent_hardener_plugin.tasks.war_game.__main__, nemo_agent_hardener_plugin.tasks.synth_benign.__main__"; \
    /opt/agent-hardener/venv/bin/agent-hardener --help >/dev/null; \
    /opt/agent-hardener/garak-venv/bin/python -c "import garak"; \
    openshell --version; \
    echo ok > .w && rm .w

FROM runtime
