# Colocated Gym task image for NeMo Helix Evals agent-evaluation jobs.
#
# Sandboxed Gym jobs use nhx-tasks to orchestrate a separate nhx-gym-host.
# This image retains Gym and Ray only for trusted deployments that run Gym
# directly in the task container.

ARG NHX_CPU_TASKS_BASE=nhx-tasks
ARG NHX_PYTHON_BASE=nhx-python-base

FROM ${NHX_CPU_TASKS_BASE} AS cpu-tasks

FROM ${NHX_PYTHON_BASE} AS gym-builder

COPY docker/locks/nhx-gym-tasks /opt/nhx-gym-tasks-lock

RUN --mount=type=cache,target=/root/.cache/uv \
    UV_CACHE_DIR=/root/.cache/uv UV_LINK_MODE=copy uv venv --python /usr/local/bin/python3.13 /opt/gym-venv \
    && UV_CACHE_DIR=/root/.cache/uv UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/gym-venv uv sync \
        --project /opt/nhx-gym-tasks-lock \
        --locked \
        --no-dev \
        --no-install-project

# CVE remediation for the isolated Gym venv.
# cryptography 50.x is not lockable yet because nemo-gym pulls mlflow>=3.15.1,
# whose current metadata caps cryptography at <50. Pin the post-sync override so
# the scanner-visible artifact is deterministic until that upstream cap moves.
# Ray's bundled Java jars carry httpcore5/jackson CVEs and are only needed for JVM workers.
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_CACHE_DIR=/root/.cache/uv UV_LINK_MODE=copy uv pip install --python /opt/gym-venv/bin/python --no-deps "cryptography==50.0.0" \
    && find /opt/gym-venv -type d -path '*/site-packages/ray/jars' -prune -exec rm -rf {} + \
    && test -z "$(find /opt/gym-venv -path '*/site-packages/ray/jars/*' -print -quit)"

ARG NHX_COLLECT_SOURCES=0
ENV NHX_COLLECT_SOURCES=${NHX_COLLECT_SOURCES}
# Update each installed Python environment and rebuild embedded Go TLS clients.
RUN --mount=from=golang:1.27.3,source=/usr/local/go,target=/usr/local/go,readonly \
    --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=bind,source=docker/scripts/update-python-trust.py,target=/tmp/update-python-trust.py,readonly \
    --mount=type=bind,source=docker/scripts/collect-go-module-sources.py,target=/tmp/collect-go-module-sources.py,readonly \
    GOTOOLCHAIN=local GOROOT=/usr/local/go python3 /tmp/update-python-trust.py

# The Gym venv's sources, collected after the update above so they match what ships; the rest of the
# image's are nhx-tasks' own, under its directory. The update collects the rebuilt wandb-core's Go
# modules into rebuilt-wandb. docker/sources/nhx-gym-tasks.json pins ray, which has no sdist, the
# packages ray bundles, and the source of distlib's Windows launchers.
COPY docker/sources/nhx-gym-tasks.json /tmp/nhx-gym-tasks.json
RUN --mount=type=cache,target=/root/.cache/uv \
    uv run --no-project --python /opt/gym-venv/bin/python \
        /usr/local/bin/collect-python-sdists.py \
        --python /opt/gym-venv/bin/python \
        --output /source-distributions/nhx-gym-tasks \
        --lock-file /opt/nhx-gym-tasks-lock/uv.lock \
        --label gym-venv && \
    python3 /usr/local/bin/collect-pinned-sources.py \
        --manifest /tmp/nhx-gym-tasks.json \
        --installed-in /opt/gym-venv/bin/python \
        --output /source-distributions/nhx-gym-tasks

FROM cpu-tasks AS runtime
COPY --from=gym-builder /usr/share/nemo-helix/source-distributions/rebuilt-wandb/ /usr/share/nemo-helix/source-distributions/rebuilt-wandb/
COPY --chown=1000:1000 --from=gym-builder /opt/gym-venv /opt/gym-venv
COPY --from=gym-builder /source-distributions/nhx-gym-tasks/ /usr/share/nemo-helix/source-distributions/nhx-gym-tasks/
COPY --from=gym-builder /usr/local/bin/python* /usr/local/bin/
COPY --from=gym-builder /usr/local/include/python3.13 /usr/local/include/python3.13
COPY --from=gym-builder /usr/local/lib/libpython3.13* /usr/local/lib/
COPY --from=gym-builder --exclude=site-packages --exclude=site-packages/** \
    /usr/local/lib/python3.13 /usr/local/lib/python3.13
RUN rm -rf /home/nvs/.cache/uv
ENV PATH="/opt/gym-venv/bin:/app/.venv/bin:$PATH" \
    PYTHONPATH=""

FROM runtime AS smoke-test
RUN gym --help >/dev/null \
    && /app/.venv/bin/python -c \
        'import importlib.metadata as m; import nemo_evals, sandboxed_gym; from opensandbox.config import ConnectionConfig; print({"nemo-evals-plugin": m.version("nemo-evals-plugin"), "nemo-sandboxed-gym": m.version("nemo-sandboxed-gym"), "opensandbox": m.version("opensandbox"), "connection_config": ConnectionConfig.__name__})' \
    && /opt/gym-venv/bin/python -c \
        'import importlib.metadata as m; import nemo_gym, ray, tiktoken; print({"nemo-gym": m.version("nemo-gym"), "ray": m.version("ray"), "tiktoken": m.version("tiktoken")})'

FROM runtime
