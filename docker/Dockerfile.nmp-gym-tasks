# Colocated Gym task image for NeMo Evaluator agent-evaluation jobs.
#
# Sandboxed Gym jobs use nmp-cpu-tasks to orchestrate a separate nmp-gym-host.
# This image retains Gym and Ray only for trusted deployments that run Gym
# directly in the task container.

ARG NMP_CPU_TASKS_BASE=nmp-cpu-tasks
ARG NMP_PYTHON_BASE=nmp-python-base

FROM ${NMP_CPU_TASKS_BASE} AS cpu-tasks

FROM ${NMP_PYTHON_BASE} AS gym-builder

COPY docker/locks/nmp-gym-tasks /opt/nmp-gym-tasks-lock

RUN --mount=type=cache,target=/root/.cache/uv \
    UV_CACHE_DIR=/root/.cache/uv UV_LINK_MODE=copy uv venv --python /usr/local/bin/python3.13 /opt/gym-venv \
    && UV_CACHE_DIR=/root/.cache/uv UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/gym-venv uv sync \
        --project /opt/nmp-gym-tasks-lock \
        --locked \
        --no-dev \
        --no-install-project

# CVE remediation for the isolated Gym venv.
# cryptography 50.x is not lockable yet because nemo-gym pulls mlflow>=3.15.1,
# whose current metadata caps cryptography at <50. Pin the post-sync override so
# the scanner-visible artifact is deterministic until that upstream cap moves.
# Ray's bundled Java jars carry httpcore5/jackson CVEs and are only needed for JVM workers.
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_CACHE_DIR=/root/.cache/uv UV_LINK_MODE=copy uv pip install --python /opt/gym-venv/bin/python --no-deps "cryptography==50.0.0" \
    && find /opt/gym-venv -type d -path '*/site-packages/ray/jars' -prune -exec rm -rf {} + \
    && test -z "$(find /opt/gym-venv -path '*/site-packages/ray/jars/*' -print -quit)"

FROM cpu-tasks AS runtime
COPY --chown=1000:1000 --from=gym-builder /opt/gym-venv /opt/gym-venv
COPY --from=gym-builder /usr/local/bin/python* /usr/local/bin/
COPY --from=gym-builder /usr/local/include/python3.13 /usr/local/include/python3.13
COPY --from=gym-builder /usr/local/lib/libpython3.13* /usr/local/lib/
COPY --from=gym-builder --exclude=site-packages --exclude=site-packages/** \
    /usr/local/lib/python3.13 /usr/local/lib/python3.13
RUN rm -rf /home/nvs/.cache/uv
ENV PATH="/opt/gym-venv/bin:/app/.venv/bin:$PATH" \
    PYTHONPATH=""

FROM runtime AS smoke-test
RUN gym --help >/dev/null \
    && /app/.venv/bin/python -c \
        'import importlib.metadata as m; import nemo_evaluator, sandboxed_gym; from opensandbox.config import ConnectionConfig; print({"nemo-evaluator-plugin": m.version("nemo-evaluator-plugin"), "nemo-sandboxed-gym": m.version("nemo-sandboxed-gym"), "opensandbox": m.version("opensandbox"), "connection_config": ConnectionConfig.__name__})' \
    && /opt/gym-venv/bin/python -c \
        'import importlib.metadata as m; import nemo_gym, ray, tiktoken; print({"nemo-gym": m.version("nemo-gym"), "ray": m.version("ray"), "tiktoken": m.version("tiktoken")})'

FROM runtime
