# Minimal Platform workspace slice for nhx-customizer-tasks container installs.
# Used as a named build context (platform-workspace).
# Keep in sync with docker/customizer/pyproject.workspace.toml members.

FROM scratch AS platform-workspace
COPY docker/customizer/pyproject.workspace.toml pyproject.toml
# uv --overrides files the tasks Dockerfile reads at /app/docker/customizer/.
COPY docker/customizer/preserve_base_torch.txt docker/customizer/preserve_base_torch.txt
COPY docker/customizer/no_override_requirements.txt docker/customizer/no_override_requirements.txt
COPY docs docs
COPY openapi openapi
COPY packages/nhx_build_tools packages/nhx_build_tools
COPY packages/filesets packages/filesets
COPY packages/models packages/models
COPY packages/nhx_common packages/nhx_common
COPY packages/nhx_customization_common packages/nhx_customization_common
COPY packages/nemo_helix_plugin packages/nemo_helix_plugin
COPY plugins/nemo-deployments plugins/nemo-deployments
COPY sdk/python/nemo-helix sdk/python/nemo-helix
COPY services/core/models services/core/models
