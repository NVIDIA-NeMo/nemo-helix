# syntax=docker/dockerfile:1
# SPDX-FileCopyrightText: Copyright (c) 2025-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
# SPDX-License-Identifier: Apache-2.0

# nhx-rl base: NeMo-RL + NeMo-Gym from source on cuda-dl-base (Python 3.13, CUDA 13).
# Pin via NEMO_RL_REF; Gym follows as RL's submodule. Train on automodel or mcore,
# generate on vllm. sglang and trtllm are not built.
#
# `uv sync` only warms the cache. Training uses the prefetched venvs below.
# Publish inherits the builder filesystem: venv pythons symlink to /opt/cpython,
# and copying them onto a fresh base would break that.

# Match the NCCL the pinned RL lock overrides. Bump with NEMO_RL_REF.
ARG BASE_IMAGE=nvcr.io/nvidia/cuda-dl-base:26.07-cuda13.3-devel-ubuntu24.04

# Source. Default clones the soluwalana/RL fork at the given ref; override with a local checkout via
# `--build-context nemo-rl=<path>` or point elsewhere via the NEMO_RL_{REPO,REF} build-args. Gym is
# NOT cloned separately - RL pins it as a git submodule (3rdparty/Gym-workspace/Gym -> soluwalana/Gym,
# https), so it (plus the Automodel / Megatron-Bridge submodules) rides in with the RL git ADD below.
# If the RL fork's uv.lock and its submodule pins drift (`uv sync --frozen` fails), pass
# `--build-arg UV_SYNC_MODE=` to relock instead.
#
# NEMO_RL_REF has no default because docker-bake.hcl holds the only pin; the ADD below must guard
# it, since an empty ref would clone the fork's default branch instead of failing.
ARG NEMO_RL_REPO=https://github.com/soluwalana/RL.git
ARG NEMO_RL_REF=

# Stay on uv 0.11.x: 0.11.18's quinn-proto is vulnerable, and 0.12 breaks us.
# Copy CPython from bookworm. uv has no linux-gnu 3.13.15, and a trixie build
# needs OpenSSL 3.3, which this Ubuntu 24.04 base does not have.
ARG UV_VERSION=0.11.33
ARG PYTHON_VERSION=3.13.15
ARG CPYTHON_IMAGE=python:${PYTHON_VERSION}-slim-bookworm
ARG CMAKE_VERSION=4.0.3

FROM ${CPYTHON_IMAGE} AS cpython

# ---- RL source. Submodules come in over https with the git ADD. ----
FROM scratch AS nemo-rl
ARG NEMO_RL_REPO
ARG NEMO_RL_REF
ADD ["${NEMO_RL_REPO}#${NEMO_RL_REF:?NEMO_RL_REF must be set; docker buildx bake passes the pin from docker-bake.hcl, a direct docker build needs --build-arg NEMO_RL_REF=<sha>}", "/"]

# ---- base: cuda-dl-base + system deps + cmake + uv + python 3.13 ----
FROM ${BASE_IMAGE} AS base
ARG BUILD_UID=2000
ARG BUILD_GID=2000
USER root
ENV DEBIAN_FRONTEND=noninteractive
RUN dpkg-query -W -f='${binary:Package}\t${Version}\n' > /tmp/base-dpkg-packages.txt

# Upgrade openssl only. A full apt upgrade would pull newer CUDA packages.
RUN --mount=type=bind,source=docker/scripts/remove-listed-apt-packages.sh,target=/tmp/remove-listed-apt-packages.sh,readonly \
    --mount=type=bind,source=docker/removals/apt/nhx-rl-base.txt,target=/tmp/apt-package-removals.txt,readonly \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    jq curl git rsync wget less vim ccache gnupg \
    build-essential ca-certificates \
    libibverbs-dev libsqlite3-0 && \
    apt-get install -y --only-upgrade openssl libssl3t64 && \
    bash /tmp/remove-listed-apt-packages.sh /tmp/apt-package-removals.txt && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# CMake (CUDA extension builds: transformer-engine, mamba-ssm, ...).
ARG CMAKE_VERSION
RUN ARCH="$(uname -m)" && \
    F="cmake-${CMAKE_VERSION}-linux-${ARCH}" && \
    curl --retry 3 --retry-delay 2 -fsSL -o "${F}.tar.gz" \
    "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/${F}.tar.gz" && \
    tar -xzf "${F}.tar.gz" && \
    cp -r "${F}/bin/"* /usr/local/bin/ && \
    cp -r "${F}/share/"* /usr/local/share/ && \
    rm -rf "${F}" "${F}.tar.gz"

# libpython and this prefix's OpenSSL live under /opt/cpython. LD_LIBRARY_PATH
# below is what lets urllib import ssl.
COPY --from=cpython /usr/local /opt/cpython
RUN chmod -R a+rX /opt/cpython

# uv installs and syncs. UV_PYTHON must be this binary: a bare 3.13.15 misses
# linux-gnu in uv's catalog, and RL's .python-version would pin 3.13.14.
# Retries cover large GitHub wheels under BuildKit.
ARG UV_VERSION
ENV UV_PYTHON=/opt/cpython/bin/python3.13 \
    LD_LIBRARY_PATH=/opt/cpython/lib \
    UV_HTTP_TIMEOUT=120 \
    UV_HTTP_RETRIES=8 \
    UV_CONCURRENT_DOWNLOADS=4 \
    PATH="/opt/cpython/bin:/usr/local/bin:/root/.local/bin:${PATH}"
RUN umask 022 && \
    curl -LsSf "https://astral.sh/uv/${UV_VERSION}/install.sh" | sh && \
    cp /root/.local/bin/uv /usr/local/bin/uv && \
    python3.13 -c 'import ssl, urllib.request; print(ssl.OPENSSL_VERSION)'
COPY --chmod=755 docker/scripts/collect-apt-sources.sh \
    docker/scripts/collect-python-sdists.py \
    docker/rl/scripts/chmod-newer-than.sh \
    /usr/local/bin/

# Build as a non-runtime user. umask 022 keeps artifacts readable; the runtime
# UID cannot rewrite the uv cache the venvs symlink into.
RUN groupadd --gid "${BUILD_GID}" nhx-build && \
    useradd --uid "${BUILD_UID}" --gid "${BUILD_GID}" --home-dir /home/nhx-build \
    --create-home --shell /bin/bash nhx-build && \
    mkdir -p /opt/nemo-rl /opt/nemo_rl_venv /opt/uv_cache /opt/ray_venvs /opt/gym_venvs && \
    chown -R "${BUILD_UID}:${BUILD_GID}" \
    /home/nhx-build /opt/nemo-rl /opt/nemo_rl_venv /opt/uv_cache /opt/ray_venvs /opt/gym_venvs

# RAY_ENABLE_UV_RUN_RUNTIME_ENV=0: Ray >=2.47 otherwise builds a uv venv per task.
# NRL_CONTAINER=1 keeps NeMo-Gym from writing a multi-GB cache into its source tree.
ENV RAY_USAGE_STATS_ENABLED=0 \
    RAY_ENABLE_UV_RUN_RUNTIME_ENV=0 \
    NRL_CONTAINER=1 \
    NEMO_RL_VENV_DIR=/opt/ray_venvs \
    NEMO_GYM_VENV_DIR=/opt/gym_venvs

# ---- gym-wheel: nemo-gym==<this fork> is published nowhere. See build-gym-wheel.sh. ----
FROM base AS gym-wheel
COPY --from=nemo-rl 3rdparty/Gym-workspace/Gym /build/Gym
RUN --mount=type=bind,source=docker/rl/scripts/build-gym-wheel.sh,target=/build/build-gym-wheel.sh \
    bash /build/build-gym-wheel.sh /build/Gym /opt/gym-wheels

# ---- builder: automodel, mcore, vllm, nemo_gym, modelopt ----
# CUDA extensions come from rl-cuda-ext-wheel at /mnt/wheels.
FROM base AS builder
ARG BUILD_UID=2000
ARG BUILD_GID=2000
WORKDIR /opt/nemo-rl

# DeepEP JIT-compiles at runtime, so nvcc and these arch flags stay. The prebuilt
# wheels are 9.0 and 10.0; deep_ep and deep_gemm are not usable on 8.0.
# TORCH_CUDA_ARCH_LIST here only affects that JIT.
ARG NVTE_BUILD_MAX_JOBS=8
ARG NVTE_BUILD_THREADS_PER_JOB=2
ARG NVTE_CUDA_ARCHS=90;100
ARG NVTE_FRAMEWORK=pytorch
ARG TORCH_CUDA_ARCH_LIST="9.0 10.0"
# CPLUS_INCLUDE_PATH: CUDA 13 moved <cuda/std/...> under include/cccl.
# CUDNN_* points Transformer Engine at the pip cuDNN wheel; the image cuDNN mismatches.
# UV_LINK_MODE is per-command, not ENV: uv rejects symlink installs with --no-cache.
# Do not delete /opt/uv_cache. Every venv symlinks into it.
ENV NVTE_BUILD_MAX_JOBS=${NVTE_BUILD_MAX_JOBS} \
    NVTE_BUILD_THREADS_PER_JOB=${NVTE_BUILD_THREADS_PER_JOB} \
    NVTE_CUDA_ARCHS=${NVTE_CUDA_ARCHS} \
    NVTE_FRAMEWORK=${NVTE_FRAMEWORK} \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    CUDA_HOME=/usr/local/cuda \
    CPLUS_INCLUDE_PATH=/usr/local/cuda/include/cccl \
    HOME=/home/nhx-build \
    UV_PROJECT_ENVIRONMENT=/opt/nemo_rl_venv \
    UV_CACHE_DIR=/opt/uv_cache \
    CUDNN_HOME=/opt/nemo_rl_venv/lib/python3.13/site-packages/nvidia/cudnn \
    CUDNN_PATH=/opt/nemo_rl_venv/lib/python3.13/site-packages/nvidia/cudnn \
    LD_LIBRARY_PATH="/opt/nemo_rl_venv/lib/python3.13/site-packages/nvidia/cudnn/lib:${LD_LIBRARY_PATH}"

# Resolver inputs only, so a source-only change misses this layer.
# Megatron-Bridge stays (mcore, plus nested Megatron-LM). TensorRT-LLM stays too:
# uv reads every path source, and its metadata hook does not compile.
COPY --from=nemo-rl --chown=${BUILD_UID}:${BUILD_GID} pyproject.toml uv.lock ./
COPY --from=nemo-rl --chown=${BUILD_UID}:${BUILD_GID} nemo_rl/__init__.py nemo_rl/package_info.py nemo_rl/transformers_compat.py ./nemo_rl/
COPY --from=nemo-rl --chown=${BUILD_UID}:${BUILD_GID} --exclude=**/.git 3rdparty/ ./3rdparty/
COPY --from=nemo-rl --chown=${BUILD_UID}:${BUILD_GID} research/ ./research/

USER ${BUILD_UID}:${BUILD_GID}

# Empty UV_SYNC_MODE relocks. Default is --frozen.
ARG UV_SYNC_MODE=--frozen

# The driver installs this from PyPI rather than from RL's lock, which resolves it for the actor
# venvs only. Keep in lockstep with the pin in NeMo-RL's pyproject.toml.
ARG NEMO_SANDBOXED_GYM_VERSION=0.1.0a1
# Warm the uv cache. Extras conflict, so each sync prunes the last; the cache is what remains.
# The two combined syncs match the worker venvs: mcore+nemo_gym and vllm+nemo_gym.
# RL's own pyproject.toml and uv.lock are used as-is. These nine packages are left out of
# the sync and installed from rl-cuda-ext-wheel after prefetch.
#
# `uv sync` is EXACT, so these do NOT accumulate - each --extra prunes the previous one and the base
# venv ends up with default deps + groups only. The populated cache is the real product.
#
# Conflicting extras resolve in separate forks but still share cache entries when a fork lands on the
# same pinned source, so mcore reuses the Transformer-Engine wheel automodel built. See README.md,
# "Why the `mcore` backend is built".
#
# --no-install-project installs dependencies but not nemo-rl itself; the root package is added
# editable in a cheap step after the full-source COPY.
#
# Then drop ray's vendored aiohttp and jars, and PyNvVideoCodec's bundled FFmpeg, before prefetch
# can symlink a venv at them. The package stays cached, so uv does not re-download it.
RUN <<"EOF" bash -eu
set -x
umask 022
export UV_LINK_MODE=symlink
stamp=$(chmod-newer-than.sh mark)
SKIP=(
    --no-install-package causal-conv1d
    --no-install-package mamba-ssm
    --no-install-package nv-grouped-gemm
    --no-install-package fast-hadamard-transform
    --no-install-package flash-mla
    --no-install-package deep-ep
    --no-install-package deep-gemm
    --no-install-package flash-attn
    --no-install-package transformer-engine-torch
)
uv venv --seed

uv sync ${UV_SYNC_MODE} --no-install-project "${SKIP[@]}"

uv sync ${UV_SYNC_MODE} --extra vllm --no-install-project "${SKIP[@]}"

uv sync ${UV_SYNC_MODE} --extra automodel --no-install-project "${SKIP[@]}"
uv sync ${UV_SYNC_MODE} --extra mcore --no-install-project "${SKIP[@]}"
uv sync ${UV_SYNC_MODE} --extra modelopt --no-install-project "${SKIP[@]}"
uv sync ${UV_SYNC_MODE} --extra nemo_gym --no-install-project "${SKIP[@]}"
uv sync ${UV_SYNC_MODE} --extra mcore --extra nemo_gym --no-install-project "${SKIP[@]}"
uv sync ${UV_SYNC_MODE} --extra vllm --extra nemo_gym --no-install-project "${SKIP[@]}"
uv sync ${UV_SYNC_MODE} --all-groups --no-install-project "${SKIP[@]}"

find "${UV_CACHE_DIR}" -type d -path "*ray/_private/runtime_env/agent/thirdparty_files/aiohttp*" -exec rm -rf {} + || true
find "${UV_CACHE_DIR}" -type d -path "*/ray/jars" -exec rm -rf {} + || true
find "${UV_CACHE_DIR}" -type d \
    \( -name PyNvVideoCodec -o -name 'pynvvideocodec-*.data' \) -exec rm -rf {} + || true
chmod-newer-than.sh "${stamp}" /opt/nemo_rl_venv
EOF

# Own layer so a pin edit does not rebuild the sync above.
# opensandbox is the Gym client. OpenTelemetry pins: opentelemetry-overrides.txt.
# Gym is --no-deps here; worker venvs get nemo_gym from the extra.
RUN --mount=type=bind,source=docker/rl/opentelemetry-overrides.txt,target=/tmp/opentelemetry-overrides.txt,readonly \
    <<"EOF" bash -eu
set -x
umask 022
export UV_LINK_MODE=symlink
stamp=$(chmod-newer-than.sh mark)
mapfile -t OTEL_PINS < <(grep -Ev '^[[:space:]]*(#|$)' /tmp/opentelemetry-overrides.txt)
OTEL_UPGRADE=()
for pin in "${OTEL_PINS[@]}"; do
    OTEL_UPGRADE+=(--reinstall-package "${pin%%==*}")
done
uv pip install --python /opt/nemo_rl_venv/bin/python "opensandbox>=0.1.9" "tenacity>=9.1.4"
# --directory /tmp: inside this project uv resolves the API back to 1.45.
uv pip install --directory /tmp --python /opt/nemo_rl_venv/bin/python \
    --upgrade-package wandb \
    "${OTEL_UPGRADE[@]}" \
    "mlflow-skinny>=3.15.0,<3.16.0" \
    "sqlparse>=0.6.0,<0.7" \
    "wandb>=0.29.0" \
    "${OTEL_PINS[@]}"
uv pip install --python /opt/nemo_rl_venv/bin/python --no-deps \
    -e /opt/nemo-rl/3rdparty/Gym-workspace/Gym
uv pip install --python /opt/nemo_rl_venv/bin/python --no-deps \
    "nemo-sandboxed-gym==${NEMO_SANDBOXED_GYM_VERSION}"
chmod-newer-than.sh "${stamp}" /opt/nemo_rl_venv /opt/nemo-rl
EOF

# ---- Per-worker venvs under /opt/ray_venvs ----
# Extras match actor_environments.py. Seven venvs, named by actor FQN the way
# prefetch_venvs.py names them. This layer does not run that script: importing
# it needs the rest of the tree, and the full source COPY is below so a
# source-only bump reuses these syncs.
#   DTensorPolicyWorkerV2 -> automodel
#   MegatronPolicyWorker  -> mcore + nemo_gym (not the quant worker)
#   VllmGenerationWorker, VllmAsyncGenerationWorker -> vllm + nemo_gym
#   SyncRolloutActor      -> vllm
#   NemoGym, SandboxedGymActor -> nemo_gym
# SandboxEpisodeBrokerActor is absent. It has no ACTOR_ENVIRONMENTS entry, and
# nemo-sandboxed-gym cannot read that registry, so the broker inherits the
# SandboxedGymActor venv from the actor that creates it.
# --no-install-project: the lock and the resolver inputs copied above are
# enough. The editable root install follows the source COPY.
RUN --mount=from=rl-cuda-ext-wheel,source=/wheels,target=/mnt/wheels,readonly \
    <<"EOF" bash -eu
set -x
umask 022
export UV_LINK_MODE=symlink
stamp=$(chmod-newer-than.sh mark)
SKIP=(
    --no-install-package causal-conv1d
    --no-install-package mamba-ssm
    --no-install-package nv-grouped-gemm
    --no-install-package fast-hadamard-transform
    --no-install-package flash-mla
    --no-install-package deep-ep
    --no-install-package deep-gemm
    --no-install-package flash-attn
    --no-install-package transformer-engine-torch
)
# Same wrapper prefetch_venvs.py writes, into the driver bin (on PATH) rather
# than /usr/local/bin, which the build user cannot write.
write_wrapper() {
    local venv="$1"
    local class_name="${venv##*.}"
    local wrapper="/opt/nemo_rl_venv/bin/python-${class_name}"
    if [[ -e "${wrapper}" ]]; then
        printf 'wrapper %s already exists\n' "${wrapper}" >&2
        exit 1
    fi
    cat > "${wrapper}" <<WRAP
#!/bin/bash
VENV_PATH="${venv}"
export VIRTUAL_ENV="\$VENV_PATH"
export PATH="\$VENV_PATH/bin:\$PATH"
exec "\$VENV_PATH/bin/python" "\$@"
WRAP
    chmod 755 "${wrapper}"
}
sync_venv() {
    local venv="$1"
    shift
    UV_PROJECT_ENVIRONMENT="${venv}" \
        uv sync ${UV_SYNC_MODE} --inexact --no-install-project --directory /opt/nemo-rl "$@" "${SKIP[@]}"
    if [[ " $* " == *" --extra nemo_gym "* ]]; then
        uv pip install --directory /tmp --python "${venv}/bin/python" \
            "nemo-sandboxed-gym[server,opensandbox,ray]==0.1.0a1" \
            "opensandbox>=0.1.9"
    fi
    # --python selects the venv. --directory keeps uv from reading the git pins in pyproject.toml.
    uv pip install --directory /tmp --python "${venv}/bin/python" --no-deps /mnt/wheels/*.whl
    write_wrapper "${venv}"
}
sync_venv /opt/ray_venvs/nemo_rl.models.policy.workers.dtensor_policy_worker_v2.DTensorPolicyWorkerV2 --extra automodel
sync_venv /opt/ray_venvs/nemo_rl.models.policy.workers.megatron_policy_worker.MegatronPolicyWorker --extra mcore --extra nemo_gym
sync_venv /opt/ray_venvs/nemo_rl.models.generation.vllm.vllm_worker.VllmGenerationWorker --extra vllm --extra nemo_gym
sync_venv /opt/ray_venvs/nemo_rl.models.generation.vllm.vllm_worker_async.VllmAsyncGenerationWorker --extra vllm --extra nemo_gym
sync_venv /opt/ray_venvs/nemo_rl.experience.sync_rollout_actor.SyncRolloutActor --extra vllm
sync_venv /opt/ray_venvs/nemo_rl.environments.nemo_gym.NemoGym --extra nemo_gym
sync_venv /opt/ray_venvs/nemo_rl.environments.sandbox.nemo_gym_actor.SandboxedGymActor --extra nemo_gym
chmod-newer-than.sh "${stamp}" /opt/ray_venvs /opt/nemo_rl_venv
EOF

# After the worker syncs, so a source-only bump reuses that layer.
# Exclude submodule .git dirs here; a later rm would still leave them in this layer.
COPY --from=nemo-rl --chown=${BUILD_UID}:${BUILD_GID} --exclude=**/.git . /opt/nemo-rl

# Pin verifiers to the package version of the v0.3.1 tag. The wrapper-dir patch
# stays so a later run of prefetch_venvs.py writes into the driver bin; this
# image already wrote those wrappers above.
RUN --mount=type=bind,source=docker/rl/patches,target=/tmp/patches,readonly \
    git -C /opt/nemo-rl apply --verbose \
    /tmp/patches/nemo-rl-verifiers-pin.patch \
    /tmp/patches/nemo-rl-prefetch-wrapper-dir.patch

# Editable root only. Dependencies were installed by the syncs above.
RUN <<"EOF" bash -eu
umask 022
stamp=$(chmod-newer-than.sh mark)
for py in /opt/nemo_rl_venv/bin/python /opt/ray_venvs/*/bin/python; do
    uv pip install --python "${py}" --no-deps -e /opt/nemo-rl
done
chmod-newer-than.sh "${stamp}" /opt/nemo_rl_venv /opt/ray_venvs /opt/nemo-rl
EOF

# ---- Per-environment Gym venvs, separate from /opt/ray_venvs. Off unless listed. ----
ARG NEMO_GYM_PREFETCH_CONFIGS=""
# Gym pins vllm==0.25.1, the CUDA 12 wheel. Override it to the cu130 build.
# RL's own vllm extra stays 0.29.0.
ARG NEMO_GYM_CUDA=cu130
ARG NEMO_GYM_VLLM_VERSION=0.25.1
ARG TARGETARCH
# Remove Ray session logs and cloned .git dirs in this layer. Re-pin
# mlflow-skinny, sqlparse, hydra-core, and OpenTelemetry afterwards, then drop
# mlflow, pynvml, and mooncake.
RUN --mount=type=bind,source=docker/rl/opentelemetry-overrides.txt,target=/tmp/opentelemetry-overrides.txt,readonly \
    <<"EOF" bash -eu
set -x
umask 022
export UV_LINK_MODE=symlink
stamp=$(chmod-newer-than.sh mark)
mapfile -t OTEL_PINS < <(grep -Ev '^[[:space:]]*(#|$)' /tmp/opentelemetry-overrides.txt)
OTEL_UPGRADE=()
for pin in "${OTEL_PINS[@]}"; do
    OTEL_UPGRADE+=(--reinstall-package "${pin%%==*}")
done
mkdir -p /opt/gym_venvs
if [ -n "${NEMO_GYM_PREFETCH_CONFIGS:-}" ]; then
    cd /opt/nemo-rl
    case "${TARGETARCH:-amd64}" in arm64) WHEEL_ARCH=aarch64 ;; *) WHEEL_ARCH=x86_64 ;; esac
    GYM_VLLM_OVERRIDE=/opt/nemo-rl/.gym-vllm-override.txt
    printf 'vllm @ https://github.com/vllm-project/vllm/releases/download/v%s/vllm-%s-cp38-abi3-manylinux_2_28_%s.whl\n' \
        "${NEMO_GYM_VLLM_VERSION}" "${NEMO_GYM_VLLM_VERSION}" "${WHEEL_ARCH}" > "${GYM_VLLM_OVERRIDE}"
    UV_TORCH_BACKEND="${NEMO_GYM_CUDA}" \
    UV_OVERRIDE="${GYM_VLLM_OVERRIDE}" \
    uv run python examples/nemo_gym/prefetch_venvs.py ${NEMO_GYM_PREFETCH_CONFIGS}
    rm -f "${GYM_VLLM_OVERRIDE}"
    rm -rf /tmp/ray /root/.ray /tmp/ray_tmp* 2>/dev/null || true
    find /opt/nemo-rl -name .git -prune -exec rm -rf {} +
fi

for py in /opt/nemo_rl_venv/bin/python /opt/ray_venvs/*/bin/python /opt/gym_venvs/*/bin/python; do
    [ -x "${py}" ] || continue
    if "${py}" -c 'import importlib.util, sys; sys.exit(0 if importlib.util.find_spec("mlflow") else 1)'; then
        uv pip install --python "${py}" --upgrade-package mlflow-skinny --upgrade-package sqlparse \
            "mlflow-skinny>=3.15.0,<3.16.0" "sqlparse>=0.6.0,<0.7"
    elif "${py}" -c 'import importlib.metadata as m; m.version("sqlparse")' >/dev/null 2>&1; then
        uv pip install --python "${py}" --no-deps --upgrade-package sqlparse "sqlparse>=0.6.0,<0.7"
    fi
    if "${py}" -c 'import importlib.metadata as m; m.version("hydra-core")' >/dev/null 2>&1; then
        uv pip install --python "${py}" --no-deps --upgrade-package hydra-core "hydra-core>=1.3.4,<1.4"
    fi
    if "${py}" -c 'import importlib.util, sys; sys.exit(0 if importlib.util.find_spec("wandb") or importlib.util.find_spec("opentelemetry") else 1)'; then
        # Outside the project, or uv keeps opentelemetry-api 1.45.
        args=(--directory /tmp --python "${py}" "${OTEL_UPGRADE[@]}" "${OTEL_PINS[@]}")
        if "${py}" -c 'import importlib.util, sys; sys.exit(0 if importlib.util.find_spec("wandb") else 1)'; then
            uv pip install "${args[@]}" --upgrade-package wandb "wandb>=0.29.0"
        else
            uv pip install "${args[@]}"
        fi
    fi
    for pkg in mlflow pynvml mooncake-transfer-engine-cuda13; do
        uv pip uninstall --python "${py}" "${pkg}" || true
    done
done

find /opt/nemo_rl_venv /opt/ray_venvs /opt/gym_venvs -type d \
    \( -path '*/site-packages/mooncake' \
       -o -path '*/site-packages/mooncake_transfer_engine_cuda13-*.dist-info' \
       -o -path '*/site-packages/mooncake_transfer_engine_cuda13.libs' \) \
    -prune -exec rm -rf {} + || true
set +x
for d in "${UV_CACHE_DIR}"/archive-v0/*/; do
    if ! compgen -G "${d}wandb-*.dist-info" >/dev/null \
        && ! compgen -G "${d}mlflow-*.dist-info" >/dev/null \
        && ! compgen -G "${d}mlflow_skinny-*.dist-info" >/dev/null \
        && ! compgen -G "${d}hydra_core-*.dist-info" >/dev/null \
        && ! compgen -G "${d}sqlparse-*.dist-info" >/dev/null \
        && ! compgen -G "${d}mooncake_transfer_engine_cuda13-*.dist-info" >/dev/null; then
        continue
    fi
    if compgen -G "${d}mooncake_transfer_engine_cuda13-*.dist-info" >/dev/null; then
        find "${UV_CACHE_DIR}/wheels-v6" -type l -lname "*$(basename "${d}")*" -delete
        rm -rf "${d}"
        continue
    fi
    find /opt/nemo_rl_venv /opt/ray_venvs /opt/gym_venvs -lname "*$(basename "${d}")*" -print -quit 2>/dev/null | grep -q . && continue
    find "${UV_CACHE_DIR}/wheels-v6" -type l -lname "*$(basename "${d}")*" -delete
    rm -rf "${d}"
done
set -x
chmod-newer-than.sh "${stamp}" /opt/nemo_rl_venv /opt/ray_venvs /opt/gym_venvs
EOF

USER root

# nemo_rl compares this to the source on import when NRL_CONTAINER=1.
# Use the venv interpreter; this stage has no python on PATH.
RUN /opt/nemo_rl_venv/bin/python tools/generate_fingerprint.py \
    > /opt/nemo_rl_container_fingerprint

# ---- publish: inherit the builder filesystem so /opt/cpython stays valid ----
FROM builder AS nhx-rl-base
ARG RUNTIME_UID=1000
ARG RUNTIME_GID=1000

# Megatron-Bridge's build env pins setuptools<80, which the project override
# cannot reach. Drop unreferenced setuptools archives (CVE in vendored jaraco).
# The mcore venv's locked setuptools is referenced, so it stays.
RUN <<"EOF" bash -eu
for d in "${UV_CACHE_DIR}"/archive-v0/*/; do
    ls "${d}"setuptools-*.dist-info >/dev/null 2>&1 || continue
    find /opt/nemo_rl_venv /opt/ray_venvs /opt/gym_venvs -lname "*$(basename "${d}")*" -print -quit 2>/dev/null | grep -q . && continue
    find "${UV_CACHE_DIR}/wheels-v6" -type l -lname "*$(basename "${d}")*" -delete
    rm -rf "${d}"
done
EOF

# Keep nvcc, gcc, libibverbs, git, and curl: DeepEP JIT and native env builds need them.
# Do not prune /opt/uv_cache. Nsight is removed for Go stdlib CVEs; it lives in an
# ancestor layer, so this does not shrink the pulled image.
RUN apt-get purge -y ccache vim vim-common less >/dev/null 2>&1 || true; \
    apt-get autoremove -y >/dev/null 2>&1 || true; \
    rm -rf \
    /usr/local/bin/cmake /usr/local/bin/cpack /usr/local/bin/ctest /usr/local/bin/ccmake \
    /usr/local/share/cmake-* \
    /root/.cache/ccache \
    /var/lib/apt/lists/* \
    /usr/local/cuda*/NsightSystems-cli-* /usr/local/cuda*/nsight-compute-* \
    /opt/nvidia/nsight-systems-cli /opt/nvidia/nsight-compute \
    /usr/local/bin/nsys /usr/local/bin/nsys-ui /usr/local/bin/ncu /usr/local/bin/ncu-ui \
    || true
# Local nemo-gym candidate. Not set in `base`, so earlier uv steps never see a missing path.
COPY --from=gym-wheel /opt/gym-wheels /opt/gym-wheels

# Skip `git rev-parse` on import. There is no .git, and each worker would fork one.
ENV VIRTUAL_ENV=/opt/nemo_rl_venv \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    PATH="/opt/nemo_rl_venv/bin:/usr/local/bin:${PATH}" \
    UV_FIND_LINKS=/opt/gym-wheels \
    NO_VCS_VERSION=1

# Group-writable parents so the runtime user can add venvs. File modes are set
# in the RUN that creates them; chmod -R here would copy every inode up.
RUN chown root:${RUNTIME_GID} /opt/ray_venvs /opt/gym_venvs && \
    chmod 1775 /opt/ray_venvs /opt/gym_venvs

# NeMo-RL patches vllm in place and writes a per-venv py_executable. The shared
# symlink is read-only and would be one copy for every venv. cp -rL makes each
# venv's copy private.
RUN <<"EOF" bash -eu
set -x
for sp in /opt/ray_venvs/*/lib/python*/site-packages; do
    [ -d "${sp}/vllm" ] || continue
    cp -rL --preserve=mode,timestamps "${sp}/vllm" "${sp}/.vllm.private"
    rm -rf "${sp}/vllm"
    mv "${sp}/.vllm.private" "${sp}/vllm"
    chmod -R a+rX "${sp}/vllm"
    chown -R ${RUNTIME_UID}:${RUNTIME_GID} "${sp}/vllm"
done
EOF

ARG NHX_COLLECT_SOURCES=0
ENV NHX_COLLECT_SOURCES=${NHX_COLLECT_SOURCES}
RUN --mount=type=cache,target=/root/.cache/uv <<'EOF' bash -eu
source_dir=/usr/share/nemo-helix/source-distributions/nhx-rl-base
bash /usr/local/bin/collect-apt-sources.sh "${source_dir}/apt" \
    --changed-from /tmp/base-dpkg-packages.txt
uv run --no-project --python /opt/nemo_rl_venv/bin/python \
    /usr/local/bin/collect-python-sdists.py \
    --python /opt/nemo_rl_venv/bin/python \
    --output "${source_dir}" \
    --lock-file /opt/nemo-rl/uv.lock \
    --label nemo-rl-venv
for python_path in /opt/ray_venvs/*/bin/python /opt/gym_venvs/*/bin/python; do
    [ -x "${python_path}" ] || continue
    label="$(printf '%s' "${python_path%/bin/python}" | sed -E 's#^/opt/##; s#[^A-Za-z0-9_.-]+#-#g')"
    uv run --no-project --python "${python_path}" \
        /usr/local/bin/collect-python-sdists.py \
        --python "${python_path}" \
        --output "${source_dir}" \
        --lock-file /opt/nemo-rl/uv.lock \
        --label "${label}"
done
EOF

# Runtime Gym builds write egg-info under these directories.
RUN GYM_ROOT=/opt/nemo-rl/3rdparty/Gym-workspace/Gym && \
    mkdir -p "${GYM_ROOT}/cache" && \
    chown -R ${RUNTIME_UID}:${RUNTIME_GID} \
    "${GYM_ROOT}/cache" \
    "${GYM_ROOT}/resources_servers" \
    "${GYM_ROOT}/responses_api_agents" \
    "${GYM_ROOT}/responses_api_models" && \
    find /opt/uv_cache /opt/nemo_rl_venv /opt/ray_venvs /opt/gym_venvs -xtype l -delete

WORKDIR /opt/nemo-rl

# Published as nhx-rl-base, so the default user is not root. Downstream images
# switch back to root for their own build steps.
USER ${RUNTIME_UID}:${RUNTIME_GID}
